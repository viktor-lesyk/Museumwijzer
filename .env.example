# Museumwijzer Enrichment Pipeline Configuration Example
# Copy this file to .env and configure your free-tier endpoints.
# NEVER commit .env to version control.
# Card-metered / billing-enabled providers (e.g. Brave, paid models) are strictly prohibited.

# 1. Primary Extractor (Gemini Flash-Lite via local LiteLLM proxy)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_FREE_LITE_MODEL=free-lite
LITELLM_API_KEY=sk-localproxy

# 2. Second Opinion Model (OpenRouter Free-tier - must end with ':free')
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_FREE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 3. Search Provider (Tavily free tier: 1,000 requests/month, no credit card required)
# Note: Brave API is removed/forbidden (card-gated metered billing since Feb 2026).
TAVILY_API_KEY=your_tavily_api_key_here

# 4. Contact Email (included in User-Agent header and preview release prototype banner)
MUSEUMWIJZER_CONTACT=contact@example.com
CONTACT_EMAIL=contact@example.com

# 5. Build Configuration
# Set PREVIEW=false to disable the prototype banner and enable search engine indexing (index, follow).
# Defaults to true (noindex, nofollow, prototype banner active).
PREVIEW=true

