# Museumwijzer Enrichment Agent Configuration Example
# Copy this file to .env and configure your local or remote OpenAI-compatible endpoint.
# NEVER commit .env to version control.

# 1. Base URL for OpenAI-compatible endpoint
# Local Ollama: http://localhost:11434/v1
# OpenRouter:   https://openrouter.ai/api/v1
# Groq:         https://api.groq.com/openai/v1
ENRICH_BASE_URL=http://localhost:11434/v1

# 2. API Key (optional for local Ollama, required for OpenRouter / Groq)
ENRICH_API_KEY=your_api_key_here

# 3. Extractor Model (handles research and tool calling)
# Local:      qwen3.5:9b
# OpenRouter: meta-llama/llama-3.3-70b-instruct:free
ENRICH_EXTRACTOR_MODEL=qwen3.5:9b

# 4. Verifier Model (independent model family - MUST be different from Extractor)
# Local:      deepseek-r1:1.5b
# OpenRouter: google/gemini-2.0-flash-exp:free
ENRICH_VERIFIER_MODEL=deepseek-r1:1.5b

# 5. Escalation Model (optional stronger model for retry ladder - MUST be different family from Verifier)
# OpenRouter: meta-llama/llama-3.3-70b-instruct:free
ENRICH_ESCALATION_MODEL=


# 6. Search Provider API Key (optional, for web_search tool fallback)
# Tavily API: https://tavily.com
# Brave API:  https://brave.com/search/api/
TAVILY_API_KEY=
BRAVE_API_KEY=

# 7. Scraper Etiquette Contact Email
MUSEUMWIJZER_CONTACT=admin@example.com

