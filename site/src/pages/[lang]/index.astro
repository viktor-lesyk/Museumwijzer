<script>
  import L from 'leaflet';
  (window as any).L = L;
</script>

<!-- Progressive enhancement client search, filter, geolocation, and priority list script -->
<script is:inline define:vars={{
  cityAliases: cityAliasesData,
  cityCentroids: cityCentroids,
  notFoundTemplate: t.notFoundText,
  notFoundTitleTemplate: t.notFoundTitle,
  formattedDate: formattedDate,
  resultsCountTemplate: t.resultsCount,
  resultsCountSingleTemplate: t.resultsCountSingle,
  distanceTemplate: t.nearMeDistanceKm,
  locatingText: t.nearMeLocating,
  permissionDeniedText: t.nearMePermissionDenied,
  addToListText: t.addToList,
  inYourListText: t.inYourList,
  detectedLocationText: t.detectedLocation,
  chosenLocationText: t.chosenLocation,
  locationNotFoundText: t.locationNotFound,
  locationAndDistanceText: t.locationAndDistance,
  setLocationBtnText: t.setLocationBtn,
  nearMeButtonText: t.nearMeButton,
  distanceFilterResultsTemplate: t.distanceFilterResults,
  canonicalMapping: canonicalMapping,
  currentLang: lang,
  viewDetailsText: t.viewDetails,
  priceFromTemplate: t.priceFrom,
  priceFreeText: t.priceFree,
  priceClosedText: t.priceClosed,
  markAsVisitedText: t.markAsVisited,
  markAsNotVisitedText: t.markAsNotVisited,
  alreadyVisitedText: t.alreadyVisited,
  visitedText: t.visited,
  hideVisitedText: t.hideVisited,
  showVisitedText: t.showVisited,
  visitedHiddenNoticeTemplate: t.visitedHiddenNotice,
  allRatingsText: t.allRatings,
  allReviewCountsText: t.allReviewCounts,
  filterByRatingText: t.filterByRating,
  filterByDistanceText: t.filterByDistance
}}>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const provinceSelect = document.getElementById('province-select');
    const citySelect = document.getElementById('city-select');
    const maxDistanceSelect = document.getElementById('max-distance-select');
    const sortSelect = document.getElementById('sort-select');
    const distanceSortOption = document.getElementById('distance-sort-option');
    const priceFilterSelect = document.getElementById('price-filter-select');
    const ratingFilterSelect = document.getElementById('rating-filter-select');
    const categoryFilterSelect = document.getElementById('category-filter-select');
    const categoryPills = Array.from(document.querySelectorAll('.category-pill'));
    const selectedCategories = new Set();

    function updateCategoryPillsUI() {
      categoryPills.forEach((pill) => {
        const cat = pill.dataset.category;
        if (cat === 'all') {
          pill.classList.toggle('active', selectedCategories.size === 0);
          pill.setAttribute('aria-pressed', selectedCategories.size === 0 ? 'true' : 'false');
        } else {
          const isActive = selectedCategories.has(cat);
          pill.classList.toggle('active', isActive);
          pill.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }
      });
      if (categoryFilterSelect) {
        categoryFilterSelect.value = selectedCategories.size === 1 ? Array.from(selectedCategories)[0] : '';
      }
    }

    categoryPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.dataset.category;
        if (cat === 'all') {
          selectedCategories.clear();
        } else {
          if (selectedCategories.has(cat)) {
            selectedCategories.delete(cat);
          } else {
            selectedCategories.add(cat);
          }
        }
        updateCategoryPillsUI();
        sortAndFilterCards();
        if (currentViewMode === 'map') updateMapMarkers();
      });
    });

    const sortSecondarySelect = document.getElementById('sort-secondary-select');
    const distanceSortSecondaryOption = document.getElementById('distance-sort-secondary-option');
    const clearBtn = document.getElementById('clear-filters-btn');
    const resultsCountEl = document.getElementById('results-count');
    const notFoundBox = document.getElementById('not-found-box');
    const notFoundTitle = document.getElementById('not-found-title');
    const notFoundText = document.getElementById('not-found-text');
    const museumsList = document.getElementById('museums-list');
    const nearMeBtn = document.getElementById('near-me-btn');
    const nearMeText = document.getElementById('near-me-text');
    const locationToggleBtn = document.getElementById('location-toggle-btn');
    const locationPopover = document.getElementById('location-popover');
    const locBtnLabel = document.getElementById('loc-btn-label');
    const locationBarIdle = document.getElementById('location-bar-idle');
    const locationBarActive = document.getElementById('location-bar-active');
    const locationActiveText = document.getElementById('location-active-text');
    const manualLocationInput = document.getElementById('manual-location-input');
    const manualLocationBtn = document.getElementById('manual-location-btn');
    const changeLocationBtn = document.getElementById('change-location-btn');
    const clearLocationBtn = document.getElementById('clear-location-btn');
    const locationFeedbackMsg = document.getElementById('location-feedback-msg');
    const cards = Array.from(document.querySelectorAll('.museum-card'));

    if (locationToggleBtn && locationPopover) {
      locationToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = locationPopover.style.display !== 'none';
        locationPopover.style.display = isOpen ? 'none' : 'block';
        locationToggleBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (!isOpen) {
          if (ratingPopover) {
            ratingPopover.style.display = 'none';
            if (ratingToggleBtn) ratingToggleBtn.setAttribute('aria-expanded', 'false');
          }
          if (sortPopover) {
            sortPopover.style.display = 'none';
            if (sortToggleBtn) sortToggleBtn.setAttribute('aria-expanded', 'false');
          }
          if (manualLocationInput) {
            setTimeout(() => manualLocationInput.focus(), 50);
          }
        }
      });

      locationPopover.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      document.addEventListener('click', (e) => {
        if (locationPopover.style.display !== 'none') {
          locationPopover.style.display = 'none';
          locationToggleBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && locationPopover.style.display !== 'none') {
          locationPopover.style.display = 'none';
          locationToggleBtn.setAttribute('aria-expanded', 'false');
          locationToggleBtn.focus();
        }
      });
    }

    // Rating & Reviews Popover handling
    const ratingToggleBtn = document.getElementById('rating-toggle-btn');
    const ratingPopover = document.getElementById('rating-popover');
    const ratingBtnLabel = document.getElementById('rating-btn-label');
    const ratingSliderDisplay = document.getElementById('rating-slider-display');
    const reviewsDisplayBadge = document.getElementById('reviews-display-badge');
    const ratingPresetChips = Array.from(document.querySelectorAll('.rating-preset-chip'));
    const reviewPresetChips = Array.from(document.querySelectorAll('.review-preset-chip'));
    const ratingPopoverReset = document.getElementById('rating-popover-reset');
    const ratingPopoverDone = document.getElementById('rating-popover-done');

    let minRatingScore = 0;
    let minReviewCount = 0;

    function updateRatingButtonUI() {
      if (!ratingBtnLabel || !ratingToggleBtn) return;
      if (minRatingScore > 0 && minReviewCount > 0) {
        ratingBtnLabel.textContent = `⭐ ≥${minRatingScore.toFixed(1)} (${minReviewCount}+)`;
        ratingToggleBtn.classList.add('active');
      } else if (minRatingScore > 0) {
        ratingBtnLabel.textContent = `⭐ ≥${minRatingScore.toFixed(1)}`;
        ratingToggleBtn.classList.add('active');
      } else if (minReviewCount > 0) {
        ratingBtnLabel.textContent = `⭐ ≥${minReviewCount}+ rev`;
        ratingToggleBtn.classList.add('active');
      } else {
        ratingBtnLabel.textContent = filterByRatingText;
        ratingToggleBtn.classList.remove('active');
      }

      if (ratingSliderDisplay) {
        ratingSliderDisplay.textContent = minRatingScore > 0 ? `≥ ${minRatingScore.toFixed(1)} ⭐` : allRatingsText;
      }
      if (reviewsDisplayBadge) {
        reviewsDisplayBadge.textContent = minReviewCount > 0 ? `≥ ${minReviewCount}` : allReviewCountsText;
      }

      ratingPresetChips.forEach((chip) => {
        const s = parseFloat(chip.dataset.score);
        const isActive = (s === 0 && minRatingScore === 0) || (s > 0 && Math.abs(s - minRatingScore) < 0.05);
        chip.classList.toggle('active', isActive);
      });

      reviewPresetChips.forEach((chip) => {
        const r = parseInt(chip.dataset.reviews, 10);
        const isActive = (r === 0 && minReviewCount === 0) || (r > 0 && r === minReviewCount);
        chip.classList.toggle('active', isActive);
      });
    }

    if (ratingToggleBtn && ratingPopover) {
      ratingToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = ratingPopover.style.display !== 'none';
        ratingPopover.style.display = isOpen ? 'none' : 'block';
        ratingToggleBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (!isOpen) {
          if (locationPopover) {
            locationPopover.style.display = 'none';
            if (locationToggleBtn) locationToggleBtn.setAttribute('aria-expanded', 'false');
          }
          if (sortPopover) {
            sortPopover.style.display = 'none';
            if (sortToggleBtn) sortToggleBtn.setAttribute('aria-expanded', 'false');
          }
        }
      });

      ratingPopover.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      document.addEventListener('click', (e) => {
        if (ratingPopover.style.display !== 'none') {
          ratingPopover.style.display = 'none';
          ratingToggleBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && ratingPopover.style.display !== 'none') {
          ratingPopover.style.display = 'none';
          ratingToggleBtn.setAttribute('aria-expanded', 'false');
          ratingToggleBtn.focus();
        }
      });
    }

    ratingPresetChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const s = parseFloat(chip.dataset.score);
        minRatingScore = s;
        updateRatingButtonUI();
        sortAndFilterCards();
        if (currentViewMode === 'map') updateMapMarkers();
      });
    });

    reviewPresetChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const r = parseInt(chip.dataset.reviews, 10);
        minReviewCount = r;
        updateRatingButtonUI();
        sortAndFilterCards();
        if (currentViewMode === 'map') updateMapMarkers();
      });
    });

    if (ratingPopoverReset) {
      ratingPopoverReset.addEventListener('click', () => {
        minRatingScore = 0;
        minReviewCount = 0;
        updateRatingButtonUI();
        sortAndFilterCards();
        if (currentViewMode === 'map') updateMapMarkers();
      });
    }

    if (ratingPopoverDone) {
      ratingPopoverDone.addEventListener('click', () => {
        if (ratingPopover) ratingPopover.style.display = 'none';
        if (ratingToggleBtn) {
          ratingToggleBtn.setAttribute('aria-expanded', 'false');
          ratingToggleBtn.focus();
        }
      });
    }

    // Sort Popover handling
    const sortToggleBtn = document.getElementById('sort-toggle-btn');
    const sortPopover = document.getElementById('sort-popover');
    const sortBtnLabel = document.getElementById('sort-btn-label');
    const sortPopoverDone = document.getElementById('sort-popover-done');

    function updateSortButtonLabel() {
      if (!sortBtnLabel || !sortSelect) return;
      const primaryVal = sortSelect.value;
      const secondaryVal = sortSecondarySelect ? sortSecondarySelect.value : 'none';

      const shortMap = {
        'name': 'Naam (A-Z)',
        'rating-desc': 'Score (⭐)',
        'reviews-desc': 'Reviews',
        'price-desc': 'Prijs (hoog)',
        'price-asc': 'Prijs (laag)',
        'province': 'Provincie',
        'distance': 'Afstand'
      };

      const pText = shortMap[primaryVal] || (sortSelect.options[sortSelect.selectedIndex]?.text || 'Naam');

      if (secondaryVal && secondaryVal !== 'none' && secondaryVal !== primaryVal) {
        const sText = shortMap[secondaryVal] || (sortSecondarySelect.options[sortSecondarySelect.selectedIndex]?.text || '');
        sortBtnLabel.textContent = `${pText} · 2e: ${sText}`;
        if (sortToggleBtn) sortToggleBtn.classList.add('active');
      } else {
        sortBtnLabel.textContent = pText;
        if (sortToggleBtn) {
          if (primaryVal !== 'name') {
            sortToggleBtn.classList.add('active');
          } else {
            sortToggleBtn.classList.remove('active');
          }
        }
      }
    }

    if (sortToggleBtn && sortPopover) {
      sortToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = sortPopover.style.display !== 'none';
        sortPopover.style.display = isOpen ? 'none' : 'block';
        sortToggleBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (!isOpen) {
          if (locationPopover) {
            locationPopover.style.display = 'none';
            if (locationToggleBtn) locationToggleBtn.setAttribute('aria-expanded', 'false');
          }
          if (ratingPopover) {
            ratingPopover.style.display = 'none';
            if (ratingToggleBtn) ratingToggleBtn.setAttribute('aria-expanded', 'false');
          }
        }
      });

      sortPopover.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      document.addEventListener('click', (e) => {
        if (sortPopover.style.display !== 'none') {
          sortPopover.style.display = 'none';
          sortToggleBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sortPopover.style.display !== 'none') {
          sortPopover.style.display = 'none';
          sortToggleBtn.setAttribute('aria-expanded', 'false');
          sortToggleBtn.focus();
        }
      });
    }

    if (sortPopoverDone) {
      sortPopoverDone.addEventListener('click', () => {
        if (sortPopover) sortPopover.style.display = 'none';
        if (sortToggleBtn) {
          sortToggleBtn.setAttribute('aria-expanded', 'false');
          sortToggleBtn.focus();
        }
      });
    }

    const btnViewGrid = document.getElementById('btn-view-grid');
    const btnViewMap = document.getElementById('btn-view-map');
    const countryMapSection = document.getElementById('country-map-section');
    const countryMapEl = document.getElementById('country-map');

    let countryMap = null;
    let mapMarkers = [];
    let currentViewMode = 'grid';

    function initCountryMap() {
      if (countryMap || !window.L || !countryMapEl) return;
      window.L.Icon.Default.imagePath = '/leaflet/images/';

      countryMap = window.L.map(countryMapEl, {
        center: [52.1326, 5.2913],
        zoom: 8,
        scrollWheelZoom: true,
      });

      window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(countryMap);

      updateMapMarkers();
    }

    function updateMapMarkers() {
      if (!countryMap || !window.L) return;

      mapMarkers.forEach((m) => countryMap.removeLayer(m));
      mapMarkers = [];

      const visibleCards = cards.filter((c) => c.style.display !== 'none');
      const bounds = [];

      visibleCards.forEach((card) => {
        const lat = parseFloat(card.dataset.lat);
        const lon = parseFloat(card.dataset.lon);
        if (isNaN(lat) || isNaN(lon)) return;

        const slug = card.dataset.slug;
        const name = card.dataset.name;
        const city = card.dataset.city;
        const prov = card.dataset.province;
        const priceVal = card.dataset.price;
        const status = card.dataset.status;

        let priceHtml = '';
        if (status === 'free') {
          priceHtml = `<span class="map-popup-price">${priceFreeText}</span>`;
        } else if (priceVal && priceVal !== '0') {
          priceHtml = `<span class="map-popup-price">${priceFromTemplate.replace('{price}', priceVal)}</span>`;
        }

        const popupContent = `
          <div class="map-popup-card">
            <h3 class="map-popup-title"><a href="/${currentLang}/museum/${slug}/">${name}</a></h3>
            <p class="map-popup-loc">${city || ''}, ${prov || ''}</p>
            ${priceHtml}
            <div><a href="/${currentLang}/museum/${slug}/" class="map-popup-link">${viewDetailsText} →</a></div>
          </div>
        `;

        const marker = window.L.marker([lat, lon]).bindPopup(popupContent);
        marker.addTo(countryMap);
        mapMarkers.push(marker);
        bounds.push([lat, lon]);
      });

      if (bounds.length > 0 && bounds.length < cards.length) {
        countryMap.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
      } else if (bounds.length === cards.length) {
        countryMap.setView([52.1326, 5.2913], 8);
      }
    }

