<!-- Progressive enhancement client search, filter, geolocation, and priority list script -->
<script is:inline define:vars={{
  cityAliases: cityAliasesData,
  cityCentroids: cityCentroids,
  notFoundTemplate: t.notFoundText,
  notFoundTitleTemplate: t.notFoundTitle,
  formattedDate: formattedDate,
  resultsCountTemplate: t.resultsCount,
  resultsCountSingleTemplate: t.resultsCountSingle,
  distanceTemplate: t.nearMeDistanceKm,
  locatingText: t.nearMeLocating,
  permissionDeniedText: t.nearMePermissionDenied,
  addToListText: t.addToList,
  inYourListText: t.inYourList,
  detectedLocationText: t.detectedLocation,
  chosenLocationText: t.chosenLocation,
  locationNotFoundText: t.locationNotFound,
  setLocationBtnText: t.setLocationBtn,
  nearMeButtonText: t.nearMeButton,
  distanceFilterResultsTemplate: t.distanceFilterResults,
  canonicalMapping: canonicalMapping,
  currentLang: lang,
  viewDetailsText: t.viewDetails,
  priceFromTemplate: t.priceFrom,
  priceFreeText: t.priceFree,
  priceClosedText: t.priceClosed,
  markAsVisitedText: t.markAsVisited,
  markAsNotVisitedText: t.markAsNotVisited,
  alreadyVisitedText: t.alreadyVisited,
  visitedText: t.visited,
  hideVisitedText: t.hideVisited,
  showVisitedText: t.showVisited,
  visitedHiddenNoticeTemplate: t.visitedHiddenNotice
}}>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const provinceSelect = document.getElementById('province-select');
    const citySelect = document.getElementById('city-select');
    const maxDistanceSelect = document.getElementById('max-distance-select');
    const sortSelect = document.getElementById('sort-select');
    const distanceSortOption = document.getElementById('distance-sort-option');
    const priceFilterSelect = document.getElementById('price-filter-select');
    const categoryFilterSelect = document.getElementById('category-filter-select');
    const categoryPills = Array.from(document.querySelectorAll('.category-pill'));
    const selectedCategories = new Set();

    function updateCategoryPillsUI() {
      categoryPills.forEach((pill) => {
        const cat = pill.dataset.category;
        if (cat === 'all') {
          pill.classList.toggle('active', selectedCategories.size === 0);
          pill.setAttribute('aria-pressed', selectedCategories.size === 0 ? 'true' : 'false');
        } else {
          const isActive = selectedCategories.has(cat);
          pill.classList.toggle('active', isActive);
          pill.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }
      });
      if (categoryFilterSelect) {
