---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import yaml from 'yaml';
import Layout from '../../layouts/Layout.astro';
import { languages, type Locale } from '../../i18n/languages';
import { useTranslations, getCategoryLabel } from '../../i18n/ui';
import museumsData from '../../../../data/museums.json';
import metaData from '../../../../data/meta.json';
import pricesData from '../../../../data/enrichment/prices.json';
import descriptionsData from '../../../../data/enrichment/descriptions.json';
import {
  formatPriceNumber,
  formatCheckedDate,
  formatVariantLabel,
  getReportWrongPriceUrl,
  type PriceRecord,
} from '../../utils/price';
import { getMuseumRating, formatReviewsCount } from '../../utils/rating';
import 'leaflet/dist/leaflet.css';

const aliasesPath = fileURLToPath(new URL('../../../../data/city-aliases.yaml', import.meta.url));
const cityAliasesData = yaml.parse(fs.readFileSync(aliasesPath, 'utf-8')) || {};

export function getStaticPaths() {
  return [
    { params: { lang: 'nl' } },
    { params: { lang: 'en' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const canonicalMapping: Record<string, string> = {};
for (const m of (museumsData.museums || [])) {
  if ((m as any).duplicate_of) {
    canonicalMapping[m.slug] = (m as any).duplicate_of;
  }
}
const museums = (museumsData.museums || []).filter((m: any) => m.status !== 'removed' && !m.duplicate_of);

const pricesMap: Record<string, PriceRecord> = {};
for (const p of (pricesData.museums || [])) {
  if (p.slug && p.price) {
    pricesMap[p.slug] = p.price;
  }
}

const descriptionsMap: Record<string, any> = {};
for (const d of (descriptionsData.museums || [])) {
  if (d.slug) {
    descriptionsMap[d.slug] = d;
  }
}

let formattedDate = 'onbekend';
if (metaData?.last_checked) {
  try {
    const d = new Date(metaData.last_checked);
    const dateLocales: Record<Locale, string> = {
      nl: 'nl-NL',
      en: 'en-GB',
      uk: 'uk-UA',
    };
    formattedDate = d.toLocaleDateString(dateLocales[lang] || 'nl-NL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    formattedDate = metaData.last_checked.slice(0, 10);
  }
}

function getCityAliases(m: any): string {
  const aliases: string[] = [];
  if (m.pdok_woonplaats && m.pdok_woonplaats !== m.city) {
    aliases.push(m.pdok_woonplaats);
  }
  const normCity = (m.city || '').toLowerCase().trim();
  for (const [alias, canonical] of Object.entries(cityAliasesData as Record<string, string>)) {
    if (canonical.toLowerCase().trim() === normCity) {
      aliases.push(alias);
    }
    if (alias.toLowerCase().trim() === normCity) {
      aliases.push(canonical);
    }
  }
  return aliases.join(', ');
}

// Collect unique provinces and cities for filter dropdowns
const provinces = Array.from(new Set(museums.map((m) => m.province).filter(Boolean))).sort();
const cities = Array.from(new Set(museums.map((m) => m.city).filter(Boolean))).sort();

// Pre-calculate city centroids for privacy-first distance fallback (§6.4)
const cityCentroids: Record<string, { lat: number; lon: number }> = {};
for (const city of cities) {
  const cityMuseums = museums.filter((m) => m.city === city && m.lat && m.lon);
  if (cityMuseums.length > 0) {
    const avgLat = cityMuseums.reduce((sum, m) => sum + (m.lat || 0), 0) / cityMuseums.length;
    const avgLon = cityMuseums.reduce((sum, m) => sum + (m.lon || 0), 0) / cityMuseums.length;
    cityCentroids[city] = { lat: Number(avgLat.toFixed(6)), lon: Number(avgLon.toFixed(6)) };
  }
}

const pageTitle =
  lang === 'nl'
    ? 'Deelnemende musea Welkom in het Museum'
    : lang === 'uk'
      ? 'Музеї-учасники програми «Ласкаво просимо до музею»'
      : 'Participating museums Welcome to the Museum';
---

<Layout title={pageTitle} locale={lang}>
  <div class="container">
    <h1 class="sr-only">{pageTitle}</h1>

    <!-- Sticky Compact Filter & Search Toolbar (≤25% screen height) -->
    <div class="sticky-filter-wrapper" id="sticky-filter-bar">
      <section class="search-section" aria-label="Museum search and filters">
        <!-- Row 1: Search bar -->
        <div class="search-box">
          <label for="search-input" class="sr-only">{t.searchPlaceholder}</label>
          <div class="search-input-wrapper">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input
              type="search"
              id="search-input"
              class="search-input"
              placeholder={t.searchPlaceholder}
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
            />
          </div>
        </div>

        <!-- Row 2: Category Pills (OR multi-select) -->
        <div class="category-pills-bar" role="group" aria-label={t.filterByCategory}>
          <button type="button" class="category-pill active" data-category="all" id="pill-all">
            <span>{t.allCategories}</span>
          </button>
          <button type="button" class="category-pill" data-category="kunst" id="pill-kunst">
            <span>🎨 {t.catArt}</span>
          </button>
          <button type="button" class="category-pill" data-category="geschiedenis" id="pill-geschiedenis">
            <span>🏛️ {t.catHistory}</span>
          </button>
          <button type="button" class="category-pill" data-category="kastelen" id="pill-kastelen">
            <span>🏰 {t.catCastles}</span>
          </button>
          <button type="button" class="category-pill" data-category="wetenschap" id="pill-wetenschap">
            <span>🔬 {t.catScience}</span>
          </button>
          <button type="button" class="category-pill" data-category="natuur" id="pill-natuur">
            <span>🌿 {t.catNature}</span>
          </button>
          <button type="button" class="category-pill" data-category="familie" id="pill-familie">
            <span>👨‍👩‍👧 {t.catFamily}</span>
          </button>
        </div>

        <!-- Hidden select for compatibility -->
        <select id="category-filter-select" style="display:none;" aria-hidden="true">
          <option value="">{t.allCategories}</option>
          <option value="kunst">{t.catArt}</option>
          <option value="geschiedenis">{t.catHistory}</option>
          <option value="kastelen">{t.catCastles}</option>
          <option value="wetenschap">{t.catScience}</option>
          <option value="natuur">{t.catNature}</option>
          <option value="familie">{t.catFamily}</option>
        </select>

        <!-- Row 3: Action Toolbar (Left: Filters, Right: Sorting & Views) -->
        <div class="filter-toolbar">
          <div class="filter-toolbar-left">
            <div class="select-wrapper-compact">
              <label for="province-select" class="sr-only">{t.filterByProvince}</label>
              <select id="province-select" class="filter-select-compact">
                <option value="">{t.allProvinces}</option>
                {provinces.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>

            <div class="select-wrapper-compact">
              <label for="city-select" class="sr-only">{t.filterByCity}</label>
              <select id="city-select" class="filter-select-compact">
                <option value="">{t.allCities}</option>
                {cities.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>

            <div class="select-wrapper-compact">
              <label for="price-filter-select" class="sr-only">{t.filterByPrice}</label>
              <select id="price-filter-select" class="filter-select-compact" title={t.filterByPrice}>
                <option value="">{t.allPrices}</option>
                <option value="20-plus">{t.price20AndUp}</option>
                <option value="15-20">{t.price15To20}</option>
                <option value="10-15">{t.price10To15}</option>
                <option value="under-10">{t.priceUnder10}</option>
                <option value="free">{t.priceFreeOption}</option>
              </select>
            </div>

            <!-- Flexible Rating & Reviews Filter Popover -->
            <div class="location-popover-container" id="rating-popover-container">
              <button
                type="button"
                id="rating-toggle-btn"
                class="btn-location-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="rating-popover"
                title={t.filterByRating}
              >
                <span class="loc-icon" aria-hidden="true">⭐</span>
                <span id="rating-btn-label" class="loc-btn-label">{t.filterByRating}</span>
                <span class="loc-arrow" aria-hidden="true">▾</span>
              </button>

              <div id="rating-popover" class="location-popover rating-popover" role="dialog" aria-modal="false" style="display: none;">
                <div class="popover-section">
                  <div class="rating-header-row">
                    <span class="popover-title">{t.minRatingScore}</span>
                    <span id="rating-slider-display" class="rating-badge-active">{t.allRatings}</span>
                  </div>

                  <div class="rating-preset-chips" role="group" aria-label={t.minRatingScore}>
                    <button type="button" class="rating-preset-chip active" data-score="0">{t.allRatings}</button>
                    <button type="button" class="rating-preset-chip" data-score="4.6">⭐ 4.6+ (Top)</button>
                    <button type="button" class="rating-preset-chip" data-score="4.5">⭐ 4.5+</button>
                    <button type="button" class="rating-preset-chip" data-score="4.3">⭐ 4.3+</button>
                    <button type="button" class="rating-preset-chip" data-score="4.0">⭐ 4.0+</button>
                  </div>

                  <div class="popover-divider"><span>reviews</span></div>

                  <div class="rating-header-row">
                    <span class="popover-title">{t.minReviewCount}</span>
                    <span id="reviews-display-badge" class="rating-badge-active">{t.allReviewCounts}</span>
                  </div>

                  <div class="reviews-preset-chips" role="group" aria-label={t.minReviewCount}>
                    <button type="button" class="review-preset-chip active" data-reviews="0">{t.allReviewCounts}</button>
                    <button type="button" class="review-preset-chip" data-reviews="100">≥ 100</button>
                    <button type="button" class="review-preset-chip" data-reviews="500">≥ 500</button>
                    <button type="button" class="review-preset-chip" data-reviews="1000">≥ 1.000</button>
                  </div>

                  <div class="rating-popover-actions">
                    <button type="button" id="rating-popover-reset" class="btn-location-action btn-location-danger">
                      {t.resetRatingFilter}
                    </button>
                    <button type="button" id="rating-popover-done" class="btn-popover-primary">
                      {t.applyRatingFilter}
                    </button>
                  </div>
                </div>
              </div>

              <!-- Hidden select for backwards-compatibility -->
              <select id="rating-filter-select" style="display:none;" aria-hidden="true" title={t.filterByRating}>
                <option value="">{t.allRatings}</option>
                <option value="4.6-plus">{t.rating46Plus}</option>
                <option value="4.5-plus">{t.rating45Plus}</option>
                <option value="4.3-plus">{t.rating43Plus}</option>
              </select>
            </div>

            <!-- Location & Distance Button with Popover -->
            <div class="location-popover-container" id="location-popover-container">
              <button
                type="button"
                id="location-toggle-btn"
                class="btn-location-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="location-popover"
              >
                <span class="loc-icon" aria-hidden="true">📍</span>
                <span id="loc-btn-label" class="loc-btn-label">{t.filterByDistance}</span>
                <span class="loc-arrow" aria-hidden="true">▾</span>
              </button>

              <div id="location-popover" class="location-popover" role="dialog" aria-modal="false" style="display: none;">
                <div class="popover-section">
                  <span class="popover-title">{t.locationAndDistance}</span>

                  <button type="button" id="near-me-btn" class="btn-popover-gps">
                    <span aria-hidden="true">📡</span> <span id="near-me-text">{t.nearMeButton}</span>
                  </button>

                  <div class="popover-divider">
                    <span>{t.orDivider}</span>
                  </div>

                  <div class="popover-manual-group">
                    <label for="manual-location-input" class="sr-only">{t.manualLocationPlaceholder}</label>
                    <input
                      type="text"
                      id="manual-location-input"
                      class="popover-location-input"
                      placeholder={t.manualLocationPlaceholder}
                      aria-label={t.manualLocationPlaceholder}
                      autocomplete="off"
                    />
                    <button type="button" id="manual-location-btn" class="btn-popover-apply">
                      {t.setLocationBtn}
                    </button>
                  </div>

                  <div class="popover-distance-group">
                    <label for="max-distance-select" class="popover-field-label">
                      {t.maxDistance}:
                    </label>
                    <select id="max-distance-select" class="filter-select-compact">
                      <option value="">{t.allDistances}</option>
                      <option value="10">{t.within10km}</option>
                      <option value="25">{t.within25km}</option>
                      <option value="50">{t.within50km}</option>
                      <option value="100">{t.within100km}</option>
                    </select>
                  </div>

                  <div class="location-bar-active" id="location-bar-active" style="display: none;">
                    <div class="location-active-info">
                      <span class="location-pin-icon" aria-hidden="true">📍</span>
                      <span id="location-active-text" class="location-active-text"></span>
                    </div>
                    <div class="location-active-actions">
                      <button type="button" id="change-location-btn" class="btn-location-action" style="display: none;">
                        {t.changeLocation}
                      </button>
                      <button type="button" id="clear-location-btn" class="btn-location-action btn-location-danger">
                        {t.clearLocation}
                      </button>
                    </div>
                  </div>

                  <div id="location-bar-idle" style="display: none;"></div>
                  <div id="location-feedback-msg" class="location-feedback-msg" style="display: none;" role="alert"></div>
                </div>
              </div>
            </div>

            <!-- Hide Visited Museums Toggle Button -->
            <button type="button" id="toggle-hide-visited-btn" class="btn-toggle-visited" aria-pressed="false" title={t.hideVisited}>
              <span class="visited-btn-icon" aria-hidden="true">👁️‍🗨️</span>
              <span id="hide-visited-text">{lang === 'nl' ? 'Bezocht' : (lang === 'uk' ? 'Відвідані' : 'Visited')}</span>
              <span id="visited-hidden-badge" class="visited-hidden-badge" style="display: none;">0</span>
            </button>

            <!-- Clear Filters Button -->
            <button type="button" id="clear-filters-btn" class="btn-clear-compact" style="display: none;">
              ✕ {t.clearFilters}
            </button>
          </div>

          <div class="filter-toolbar-right">
            <div class="location-popover-container" id="sort-popover-container">
              <button
                type="button"
                id="sort-toggle-btn"
                class="btn-location-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="sort-popover"
                title={t.sortByLabel}
              >
                <span class="loc-icon" aria-hidden="true">⇅</span>
                <span id="sort-btn-label" class="loc-btn-label">{t.sortByName}</span>
                <span class="loc-arrow" aria-hidden="true">▾</span>
              </button>

              <div id="sort-popover" class="location-popover sort-popover" role="dialog" aria-modal="false" style="display: none;">
                <div class="popover-section">
                  <span class="popover-title">{t.sortByLabel}</span>

                  <div class="sort-popover-field">
                    <label for="sort-select" class="popover-field-label">{t.sortByPrimary}:</label>
                    <select id="sort-select" class="filter-select-compact sort-popover-select" title={t.sortByPrimary}>
                      <option value="name">{t.sortByName}</option>
                      <option value="rating-desc">{t.sortByRating}</option>
                      <option value="reviews-desc">{t.sortByReviews}</option>
                      <option value="price-asc">{t.sortByPriceAsc}</option>
                      <option value="price-desc">{t.sortByPriceDesc}</option>
                      <option value="province">{t.sortByProvince}</option>
                      <option value="distance" id="distance-sort-option" disabled>{t.sortByDistance}</option>
                    </select>
                  </div>

                  <div class="sort-popover-field">
                    <label for="sort-secondary-select" class="popover-field-label">{t.sortBySecondary}:</label>
                    <select id="sort-secondary-select" class="filter-select-compact sort-popover-select" title={t.sortBySecondary}>
                      <option value="none">{t.sortNone}</option>
                      <option value="rating-desc">{t.sortByRating}</option>
                      <option value="reviews-desc">{t.sortByReviews}</option>
                      <option value="price-asc">{t.sortByPriceAsc}</option>
                      <option value="price-desc">{t.sortByPriceDesc}</option>
                      <option value="name">{t.sortByName}</option>
                      <option value="province">{t.sortByProvince}</option>
                      <option value="distance" id="distance-sort-secondary-option" disabled>{t.sortByDistance}</option>
                    </select>
                  </div>

                  <div class="sort-popover-actions">
                    <button type="button" id="sort-popover-done" class="btn-popover-primary">
                      {t.applyRatingFilter}
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="view-toggle-group-compact" role="group" aria-label={t.viewMode}>
              <a href="#list" id="btn-view-grid" class="btn-view-toggle-compact active" role="button" aria-pressed="true" title={t.gridView}>
                <span aria-hidden="true">⊞</span>
              </a>
              <a href="#map" id="btn-view-map" class="btn-view-toggle-compact" role="button" aria-pressed="false" title={t.mapView}>
                <span aria-hidden="true">🗺️</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Results Header (Count & Status) below sticky bar -->
    <div class="results-header" aria-live="polite">
      <span id="results-count" class="results-count">
        {t.resultsCount.replace('{count}', String(museums.length))}
      </span>
    </div>

    <!-- "Does X participate?" not found message box -->
    <div id="not-found-box" class="not-found-banner" style="display: none;">
      <h3 id="not-found-title" class="not-found-title">{t.notFoundTitle.replace('{date}', formattedDate)}</h3>
      <p id="not-found-text" class="not-found-desc">{t.notFoundText}</p>
      <div class="not-found-cta">
        <a href={t.officialListUrl} class="btn-outline" target="_blank" rel="noopener noreferrer">
          {t.checkOfficialList} ↗
        </a>
      </div>
    </div>

    <!-- Pre-rendered Museum Cards List (Progressive Enhancement) -->
    <section class="museums-grid" id="museums-list" aria-label="Participating museums">
      {
        museums.map((m) => {
          const priceObj = pricesMap[m.slug] || ((m as any).duplicate_of ? pricesMap[(m as any).duplicate_of] : undefined);
          const hasPrice = priceObj && (priceObj.status === 'paid' && priceObj.primary_adult_eur !== null || priceObj.status === 'free');
          const priceDataVal = hasPrice ? (priceObj.status === 'free' ? '0' : String(priceObj.primary_adult_eur)) : '';
          const descObj = descriptionsMap[m.slug] || ((m as any).duplicate_of ? descriptionsMap[(m as any).duplicate_of] : undefined);
          const cardCategories: string[] = descObj?.categories || descObj?.tags || [];
          const cardImg = descObj?.images?.[0] || descObj?.image || null;
          const ratingObj = getMuseumRating(m.slug, (m as any).duplicate_of);
          return (
            <article
              class="museum-card"
              data-slug={m.slug}
              data-name={m.name}
              data-province={m.province}
              data-city={m.city || ''}
              data-pdok-woonplaats={m.pdok_woonplaats || ''}
              data-city-aliases={getCityAliases(m)}
              data-street={m.address?.street || ''}
              data-postcode={m.address?.postcode || ''}
              data-lat={m.lat !== null && m.lat !== undefined ? String(m.lat) : ''}
              data-lon={m.lon !== null && m.lon !== undefined ? String(m.lon) : ''}
              data-price={priceDataVal}
              data-status={priceObj?.status || 'unknown'}
              data-categories={cardCategories.join(' ')}
              data-rating={ratingObj && ratingObj.rating !== null && ratingObj.rating !== undefined ? String(ratingObj.rating) : ''}
              data-reviews={ratingObj && ratingObj.reviews_count !== null && ratingObj.reviews_count !== undefined ? String(ratingObj.reviews_count) : '0'}
            >
              <div class="card-media">
                {cardImg && cardImg.url ? (
                  <img
                    src={cardImg.url}
                    alt={m.name}
                    class="card-img"
                    loading="lazy"
                  />
                ) : (
                  <div class="card-img-placeholder">
                    <span class="placeholder-icon" aria-hidden="true">🏛️</span>
                  </div>
                )}
                <div class="card-media-actions">
                  <button
                    type="button"
                    class="card-visited-btn"
                    data-slug={m.slug}
                    title={t.markAsVisited}
                    aria-label={t.markAsVisited}
                    aria-pressed="false"
                  >
                    <span class="visited-icon" aria-hidden="true">✓</span>
                    <span class="sr-only">{t.markAsVisited}</span>
                  </button>
                  <button
                    type="button"
                    class="card-list-btn"
                    data-slug={m.slug}
                    title={t.addToList}
                    aria-label={t.addToList}
                    aria-pressed="false"
                  >
                    <span class="heart-icon" aria-hidden="true">🤍</span>
                    <span class="sr-only card-list-btn-text">{t.addToList}</span>
                  </button>
                </div>
                {ratingObj && ratingObj.rating && (
                  <div class="card-rating-tag">
                    ⭐ {ratingObj.rating.toFixed(1)}
                    {ratingObj.reviews_count > 0 && (
                      <span class="rating-sub">({formatReviewsCount(ratingObj.reviews_count, lang)})</span>
                    )}
                  </div>
                )}
              </div>

              <div class="card-body">
                <div class="card-header">
                  <div class="card-header-left">
                    <span class="card-province" style="display: none;">{m.province}</span>
                    {cardCategories.slice(0, 2).map((catKey: string) => (
                      <span class="card-category-badge">{getCategoryLabel(catKey, lang)}</span>
                    ))}
                    <span class="card-visited-badge" style="display: none;">✓ {t.visited}</span>
                  </div>
                </div>

                <h2 class="card-title">
                  <a href={`/${lang}/museum/${m.slug}/`}>{m.name}</a>
                </h2>

              <div class="card-meta">
                <div class="card-location-line">
                  <span class="card-city">{m.city ? `${m.city}, ${m.province}` : m.province || 'Nederland'}</span>
                  <span class="card-distance" style="display: none;"></span>
                </div>
                {m.address?.street && <span class="card-address">{m.address.street}</span>}
              </div>

              <div class="card-price-block">
                <div class="card-price-main">
                  {priceObj && priceObj.status === 'paid' && priceObj.primary_adult_eur !== null ? (
                    <span class="price-val">{t.priceFrom.replace('{price}', formatPriceNumber(priceObj.primary_adult_eur, lang))}</span>
                  ) : priceObj && priceObj.status === 'free' ? (
                    <span class="price-val price-badge-free">{t.priceFree}</span>
                  ) : priceObj && priceObj.status === 'closed' ? (
                    <span class="price-val price-badge-closed">{t.priceClosed}</span>
                  ) : (
                    <span class="price-val price-badge-check">{t.priceCheckWebsite}</span>
                  )}
                </div>

                {priceObj && priceObj.status === 'paid' && priceObj.online_adult_eur !== null && priceObj.door_adult_eur !== null && priceObj.online_adult_eur !== priceObj.door_adult_eur && (
                  <div class="card-price-split">
                    {t.priceOnlineDoor
                      .replace('{online}', formatPriceNumber(priceObj.online_adult_eur, lang))
                      .replace('{door}', formatPriceNumber(priceObj.door_adult_eur, lang))}
                  </div>
                )}

                {priceObj && priceObj.variants && Object.keys(priceObj.variants).length > 0 && (
                  <div class="card-price-variant">
                    {Object.entries(priceObj.variants).slice(0, 1).map(([vKey, vVal]) => (
                      <span>{formatVariantLabel(vKey, lang)}: €{formatPriceNumber(vVal, lang)}</span>
                    ))}
                  </div>
                )}

                {priceObj && (priceObj.checked_on || priceObj.source_url) && (
                  <div class="card-price-meta">
                    {priceObj.checked_on && priceObj.source_url ? (
                      <a href={priceObj.source_url} class="price-checked-link" target="_blank" rel="noopener noreferrer">
                        {t.priceCheckedDate.replace('{date}', formatCheckedDate(priceObj.checked_on, lang))} ↗
                      </a>
                    ) : priceObj.checked_on ? (
                      <span class="price-checked-text">
                        {t.priceCheckedDate.replace('{date}', formatCheckedDate(priceObj.checked_on, lang))}
                      </span>
                    ) : null}
                    <span class="price-meta-sep">·</span>
                    <a href={getReportWrongPriceUrl(m.name, m.slug, priceObj.source_url, lang)} class="price-report-link">
                      {t.reportWrongPrice}
                    </a>
                  </div>
                )}
              </div>

                <div class="card-footer">
                  <a href={`/${lang}/museum/${m.slug}/`} class="card-link">
                    {t.viewDetails} →
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </section>

    <!-- Interactive Country Map View with Deep Link Anchors -->
    <div id="map" class="map-anchor" tabindex="-1"></div>
    <div id="kaart" class="map-anchor" tabindex="-1"></div>
    <section id="country-map-section" class="country-map-section" style="display: none;" aria-label={t.countryMapTitle}>
      <div id="country-map" class="country-map-container"></div>
    </section>
  </div>
</Layout>

