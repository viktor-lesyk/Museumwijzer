    function sortAndFilterCards() {
      const query = normalize(searchInput.value);
      const queryAlias = resolveAliases(query);
      const selectedProvince = provinceSelect.value;
      const selectedCity = citySelect.value;
      const maxDistance = parseFloat(maxDistanceSelect.value);
      const selectedPriceFilter = priceFilterSelect ? priceFilterSelect.value : '';
      const selectedRatingFilter = ratingFilterSelect ? ratingFilterSelect.value : '';
      const selectedCategory = categoryFilterSelect ? categoryFilterSelect.value : '';
      const sortBy = sortSelect.value;
      const secondarySort = sortSecondarySelect ? sortSecondarySelect.value : 'none';

      let visibleCards = [];

      cards.forEach((card) => {
        const name = normalize(card.dataset.name);
        const city = normalize(card.dataset.city);
        const pdokCity = normalize(card.dataset.pdokWoonplaats);
        const aliases = normalize(card.dataset.cityAliases);
        const province = card.dataset.province;
        const street = normalize(card.dataset.street);
        const postcode = normalize(card.dataset.postcode);

        const matchesQuery =
          !query ||
          name.includes(query) ||
          name.includes(queryAlias) ||
          city.includes(query) ||
          city.includes(queryAlias) ||
          pdokCity.includes(query) ||
          pdokCity.includes(queryAlias) ||
          aliases.includes(query) ||
          aliases.includes(queryAlias) ||
          province.toLowerCase().includes(query) ||
          street.includes(query) ||
          postcode.includes(query);

        const matchesProvince = !selectedProvince || province === selectedProvince;
        const matchesCity = !selectedCity || card.dataset.city === selectedCity;

        const cardDist = card.dataset.distance !== undefined ? parseFloat(card.dataset.distance) : null;
        const matchesDistance = isNaN(maxDistance) || (cardDist !== null && cardDist <= maxDistance);

        // Discrete non-overlapping price filter matching
        let matchesPrice = true;
        if (selectedPriceFilter === 'free') {
          matchesPrice = card.dataset.status === 'free' || card.dataset.price === '0';
        } else if (selectedPriceFilter === 'under-10') {
          const p = card.dataset.price !== '' ? parseFloat(card.dataset.price) : null;
          matchesPrice = p !== null && p > 0 && p < 10.0;
        } else if (selectedPriceFilter === '10-15') {
          const p = card.dataset.price !== '' ? parseFloat(card.dataset.price) : null;
          matchesPrice = p !== null && p >= 10.0 && p < 15.0;
        } else if (selectedPriceFilter === '15-20') {
          const p = card.dataset.price !== '' ? parseFloat(card.dataset.price) : null;
          matchesPrice = p !== null && p >= 15.0 && p < 20.0;
        } else if (selectedPriceFilter === '20-plus') {
          const p = card.dataset.price !== '' ? parseFloat(card.dataset.price) : null;
          matchesPrice = p !== null && p >= 20.0;
        }

        // Rating filter matching (dynamic slider & preset chips, plus fallback)
        let matchesRating = true;
        if (minRatingScore > 0) {
          const r = card.dataset.rating !== '' && card.dataset.rating !== undefined ? parseFloat(card.dataset.rating) : null;
          matchesRating = r !== null && r >= minRatingScore;
        } else if (selectedRatingFilter) {
          const r = card.dataset.rating !== '' && card.dataset.rating !== undefined ? parseFloat(card.dataset.rating) : null;
          if (selectedRatingFilter === '4.6-plus') {
            matchesRating = r !== null && r >= 4.6;
          } else if (selectedRatingFilter === '4.5-plus') {
            matchesRating = r !== null && r >= 4.5;
          } else if (selectedRatingFilter === '4.3-plus') {
            matchesRating = r !== null && r >= 4.3;
          }
        }

        // Reviews count matching
        let matchesReviews = true;
        if (minReviewCount > 0) {
          const rev = card.dataset.reviews !== '' && card.dataset.reviews !== undefined ? parseInt(card.dataset.reviews, 10) : 0;
          matchesReviews = rev >= minReviewCount;
        }

        // Category filter matching (Multi-select OR logic)
        let matchesCategory = true;
        if (selectedCategories.size > 0) {
          const cats = (card.dataset.categories || '').split(' ').filter(Boolean);
          matchesCategory = cats.some((c) => selectedCategories.has(c));
        } else if (selectedCategory) {
          const cats = (card.dataset.categories || '').split(' ').filter(Boolean);
          matchesCategory = cats.includes(selectedCategory);
        }

        // Visited filter matching
        const isCardVisited = card.dataset.visited === 'true';
        const matchesVisited = !hideVisited || !isCardVisited;

        const isVisible = matchesQuery && matchesProvince && matchesCity && matchesDistance && matchesPrice && matchesRating && matchesReviews && matchesCategory && matchesVisited;
        card.style.display = isVisible ? 'flex' : 'none';
        if (isVisible) {
          visibleCards.push(card);
        }
      });

      // Comparator helper for multi-criteria sorting
      function compareCards(a, b, key) {
        if (key === 'distance') {
          const distA = a.dataset.distance ? parseFloat(a.dataset.distance) : 99999;
          const distB = b.dataset.distance ? parseFloat(b.dataset.distance) : 99999;
          return distA - distB;
        } else if (key === 'province') {
          return (a.dataset.province || '').localeCompare(b.dataset.province || '');
        } else if (key === 'rating-desc') {
          const hasRatingA = a.dataset.rating !== '' && a.dataset.rating !== undefined;
          const hasRatingB = b.dataset.rating !== '' && b.dataset.rating !== undefined;
          if (hasRatingA && hasRatingB) {
            const rA = parseFloat(a.dataset.rating);
            const rB = parseFloat(b.dataset.rating);
            if (rB !== rA) return rB - rA;
            const revA = parseInt(a.dataset.reviews || '0', 10);
            const revB = parseInt(b.dataset.reviews || '0', 10);
            return revB - revA;
          } else if (hasRatingA && !hasRatingB) {
            return -1;
          } else if (!hasRatingA && hasRatingB) {
            return 1;
          }
          return 0;
        } else if (key === 'reviews-desc') {
          const revA = parseInt(a.dataset.reviews || '0', 10);
          const revB = parseInt(b.dataset.reviews || '0', 10);
          if (revB !== revA) return revB - revA;
          const hasRatingA = a.dataset.rating !== '' && a.dataset.rating !== undefined;
          const hasRatingB = b.dataset.rating !== '' && b.dataset.rating !== undefined;
          if (hasRatingA && hasRatingB) {
            const rA = parseFloat(a.dataset.rating);
            const rB = parseFloat(b.dataset.rating);
            return rB - rA;
          } else if (hasRatingA && !hasRatingB) {
            return -1;
          } else if (!hasRatingA && hasRatingB) {
            return 1;
          }
          return 0;
        } else if (key === 'price-asc') {
          const hasPriceA = a.dataset.price !== '' && a.dataset.price !== undefined;
          const hasPriceB = b.dataset.price !== '' && b.dataset.price !== undefined;
          if (hasPriceA && hasPriceB) {
            const pA = parseFloat(a.dataset.price);
            const pB = parseFloat(b.dataset.price);
            return pA - pB;
          } else if (hasPriceA && !hasPriceB) {
            return -1;
          } else if (!hasPriceA && hasPriceB) {
            return 1;
          }
          return 0;
        } else if (key === 'price-desc') {
          const hasPriceA = a.dataset.price !== '' && a.dataset.price !== undefined;
          const hasPriceB = b.dataset.price !== '' && b.dataset.price !== undefined;
          if (hasPriceA && hasPriceB) {
            const pA = parseFloat(a.dataset.price);
            const pB = parseFloat(b.dataset.price);
            return pB - pA;
          } else if (hasPriceA && !hasPriceB) {
            return -1;
          } else if (!hasPriceA && hasPriceB) {
            return 1;
          }
          return 0;
        } else if (key === 'name') {
          return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        }
        return 0;
      }

      // Sort visible cards (primary + secondary)
      visibleCards.sort((a, b) => {
        const comp1 = compareCards(a, b, sortBy);
        if (comp1 !== 0) return comp1;
        if (secondarySort && secondarySort !== 'none' && secondarySort !== sortBy) {
          const comp2 = compareCards(a, b, secondarySort);
          if (comp2 !== 0) return comp2;
        }
        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      });

      // Reorder cards in DOM
      visibleCards.forEach((card) => museumsList.appendChild(card));

      // Update count & banners
      const visibleCount = visibleCards.length;
      let countStr = '';
      if (visibleCount === 1) {
        countStr = resultsCountSingleTemplate;
      } else if (!isNaN(maxDistance) && userLat !== null) {
        countStr = distanceFilterResultsTemplate
          .replace('{count}', String(visibleCount))
          .replace('{distance}', String(maxDistance));
      } else {
        countStr = resultsCountTemplate.replace('{count}', String(visibleCount));
      }

      if (hideVisited) {
        const hiddenCount = cards.filter((c) => c.dataset.visited === 'true').length;
        if (hiddenCount > 0) {
          countStr += ' ' + visitedHiddenNoticeTemplate.replace('{count}', String(hiddenCount));
        }
      }
      resultsCountEl.textContent = countStr;

      if (visibleCount === 0) {
        notFoundBox.style.display = 'block';
        if (notFoundTitle) {
          notFoundTitle.textContent = notFoundTitleTemplate.replace('{date}', formattedDate);
        }
        notFoundText.textContent = notFoundTemplate.replace('{query}', searchInput.value || (maxDistance ? `${maxDistance} km` : ''));
      } else {
        notFoundBox.style.display = 'none';
      }

      // Update map markers if map view is active
      if (currentViewMode === 'map') {
        updateMapMarkers();
      }

      // Clear button visibility
      if (
        query ||
        selectedProvince ||
        selectedCity ||
        !isNaN(maxDistance) ||
        (priceFilterSelect && priceFilterSelect.value) ||
        (ratingFilterSelect && ratingFilterSelect.value) ||
        minRatingScore > 0 ||
        minReviewCount > 0 ||
        selectedCategories.size > 0 ||
        (categoryFilterSelect && categoryFilterSelect.value) ||
        sortBy !== 'name' ||
        (secondarySort && secondarySort !== 'none') ||
        userLat !== null
      ) {
        clearBtn.style.display = 'inline-block';
      } else {
        clearBtn.style.display = 'none';
      }
    }

    // Manual location submit handler
    async function handleManualLocation() {
      const query = manualLocationInput.value.trim();
      if (!query) return;

      manualLocationBtn.disabled = true;
      manualLocationBtn.textContent = locatingText;
      hideLocationFeedback();

      const result = await resolveLocationQuery(query);
      manualLocationBtn.disabled = false;
      manualLocationBtn.textContent = setLocationBtnText;

      if (result) {
        userLat = result.lat;
        userLon = result.lon;
        const placeLabel = result.prov ? `${result.name} (${result.prov})` : result.name;
        showActiveLocation(`${chosenLocationText}: ${placeLabel}`, result.name);
        updateDistances();
        sortSelect.value = 'distance';
        sortAndFilterCards();
        if (locationPopover) {
          locationPopover.style.display = 'none';
          if (locationToggleBtn) locationToggleBtn.setAttribute('aria-expanded', 'false');
        }
      } else {
        showLocationFeedback(locationNotFoundText);
      }
    }

    manualLocationBtn.addEventListener('click', handleManualLocation);
    manualLocationInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleManualLocation();
      }
    });

    changeLocationBtn.addEventListener('click', () => {
      locationBarActive.style.display = 'none';
      locationBarIdle.style.display = 'flex';
      manualLocationInput.focus();
      manualLocationInput.select();
    });

    clearLocationBtn.addEventListener('click', resetLocation);

    // Geolocation trigger
    nearMeBtn.addEventListener('click', () => {
      if (userLat !== null && nearMeBtn.classList.contains('active')) {
        // Toggle off if already active
        resetLocation();
        return;
      }

      if (!navigator.geolocation) {
        showLocationFeedback(permissionDeniedText);
        manualLocationInput.focus();
        return;
      }

      nearMeText.textContent = locatingText;
      nearMeBtn.disabled = true;
      hideLocationFeedback();

      navigator.geolocation.getCurrentPosition(
        async (position) => {
          userLat = position.coords.latitude;
          userLon = position.coords.longitude;
          nearMeText.textContent = nearMeButtonText;
          nearMeBtn.disabled = false;

          const placesList = await loadPlaces();
          const nearest = findNearestPlace(userLat, userLon, placesList);
          const coordStr = `${userLat.toFixed(2)}° N, ${userLon.toFixed(2)}° E`;
          const nearStr = nearest ? `nabij ${nearest.name} (${coordStr})` : coordStr;
          showActiveLocation(`${detectedLocationText}: ${nearStr}`, nearest ? nearest.name : 'GPS');

          updateDistances();
          sortSelect.value = 'distance';
          sortAndFilterCards();
          if (locationPopover) {
            locationPopover.style.display = 'none';
            if (locationToggleBtn) locationToggleBtn.setAttribute('aria-expanded', 'false');
          }
        },
        (error) => {
          nearMeBtn.disabled = false;
          nearMeText.textContent = nearMeButtonText;
          nearMeBtn.classList.remove('active');
          showLocationFeedback(permissionDeniedText);
          manualLocationInput.focus();
        },
        { timeout: 10000, enableHighAccuracy: false }
      );
    });

    // Distance filter listener
    maxDistanceSelect.addEventListener('change', () => {
      if (maxDistanceSelect.value !== '' && userLat === null) {
        showLocationFeedback(permissionDeniedText);
        if (locationPopover && locationPopover.style.display === 'none') {
          locationPopover.style.display = 'block';
          if (locationToggleBtn) locationToggleBtn.setAttribute('aria-expanded', 'true');
        }
        manualLocationInput.focus();
      }
      updateLocationButtonLabel();
      sortAndFilterCards();
    });

    // Card actions listener (event delegation for priority list and visited toggle)
    museumsList.addEventListener('click', (e) => {
      const visitedBtn = e.target.closest('.card-visited-btn');
      if (visitedBtn) {
        e.preventDefault();
        e.stopPropagation();
        const slug = visitedBtn.dataset.slug;
        let visitedList = getVisitedMuseums();
        const idx = visitedList.indexOf(slug);
        if (idx >= 0) {
          visitedList.splice(idx, 1);
        } else {
          visitedList.push(slug);
        }
        saveVisitedMuseums(visitedList);
        updateCardVisitedButtons();
        if (hideVisited) {
          sortAndFilterCards();
        }
        return;
      }

      const btn = e.target.closest('.card-list-btn');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      const slug = btn.dataset.slug;
      let list = getPriorityList();
      const index = list.findIndex((item) => (typeof item === 'string' ? item : item.slug) === slug);
      if (index >= 0) {
        list.splice(index, 1);
      } else {
        list.push({ slug: slug, visited: false, note: '' });
      }
      savePriorityList(list);
      updateCardListButtons();
    });

    // Filter event listeners
    searchInput.addEventListener('input', sortAndFilterCards);
    provinceSelect.addEventListener('change', sortAndFilterCards);
    citySelect.addEventListener('change', sortAndFilterCards);
    if (priceFilterSelect) priceFilterSelect.addEventListener('change', sortAndFilterCards);
    if (ratingFilterSelect) ratingFilterSelect.addEventListener('change', sortAndFilterCards);
    if (categoryFilterSelect) categoryFilterSelect.addEventListener('change', sortAndFilterCards);
    sortSelect.addEventListener('change', () => {
      updateSortButtonLabel();
      sortAndFilterCards();
    });
    if (sortSecondarySelect) {
      sortSecondarySelect.addEventListener('change', () => {
        updateSortButtonLabel();
        sortAndFilterCards();
      });
    }

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      provinceSelect.value = '';
      citySelect.value = '';
      maxDistanceSelect.value = '';
      if (priceFilterSelect) priceFilterSelect.value = '';
      if (ratingFilterSelect) ratingFilterSelect.value = '';
      minRatingScore = 0;
      minReviewCount = 0;
      updateRatingButtonUI();
      if (categoryFilterSelect) categoryFilterSelect.value = '';
      selectedCategories.clear();
      updateCategoryPillsUI();
      sortSelect.value = 'name';
      if (sortSecondarySelect) sortSecondarySelect.value = 'none';
      updateSortButtonLabel();
      resetLocation();
      searchInput.focus();
    });

    // Preload places on idle for instant responsiveness
    if (typeof requestIdleCallback === 'function') {
      requestIdleCallback(() => { loadPlaces(); });
    } else {
      setTimeout(loadPlaces, 2000);
    }

    // Initial setup
    updateCardListButtons();
    updateCardVisitedButtons();
    updateSortButtonLabel();
    updateLocationButtonLabel();
    sortAndFilterCards();
  });
</script>
