    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    max-width: 75ch;
  }

  .hero-cta .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .hero-cta .btn-primary:hover {
    background-color: var(--color-primary-hover);
    color: #ffffff;
  }

  .search-section {
    margin-bottom: 2rem;
  }

  .search-box {
    margin-bottom: 1rem;
  }

  .search-input {
    width: 100%;
    font-size: 1.125rem;
    padding: 0.85rem 1.25rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    color: var(--color-text);
    transition: border-color 0.15s ease;
  }

  .search-input:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .select-wrapper {
    flex: 1;
    min-width: 160px;
  }

  .filter-select {
    width: 100%;
    padding: 0.65rem 1rem;
    font-size: 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .filter-select-sm {
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
  }

  .btn-near-me {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.1rem;
    font-size: 0.95rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .btn-near-me:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
  }

  .btn-near-me.active {
    background-color: var(--color-badge-bg);
    color: var(--color-badge-text);
    border-color: var(--color-badge-border);
  }

  .btn-secondary {
    padding: 0.65rem 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }

  /* Location Control Bar */
  .location-bar {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
  }

  .location-bar-idle {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .location-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .manual-input-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 240px;
  }

  .manual-location-input {
    flex: 1;
    padding: 0.45rem 0.75rem;
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    outline: none;
