    // Calculate and apply distances to cards
    function updateDistances() {
      if (userLat === null || userLon === null) {
        cards.forEach((card) => {
          delete card.dataset.distance;
          const badge = card.querySelector('.card-distance');
          if (badge) badge.style.display = 'none';
        });
        distanceSortOption.disabled = true;
        if (distanceSortSecondaryOption) distanceSortSecondaryOption.disabled = true;
        if (sortSelect.value === 'distance') sortSelect.value = 'name';
        if (sortSecondarySelect && sortSecondarySelect.value === 'distance') sortSecondarySelect.value = 'none';
        updateSortButtonLabel();
        return;
      }

      distanceSortOption.disabled = false;
      if (distanceSortSecondaryOption) distanceSortSecondaryOption.disabled = false;

      cards.forEach((card) => {
        const cLat = parseFloat(card.dataset.lat);
        const cLon = parseFloat(card.dataset.lon);
        const badge = card.querySelector('.card-distance');
        if (!isNaN(cLat) && !isNaN(cLon)) {
          const distKm = haversineDistance(userLat, userLon, cLat, cLon);
          card.dataset.distance = String(distKm);
          if (badge) {
            badge.textContent = distanceTemplate.replace('{distance}', distKm.toFixed(1));
            badge.style.display = 'inline-block';
          }
        } else {
          delete card.dataset.distance;
          if (badge) badge.style.display = 'none';
        }
      });
    }

    let activeLocationName = null;

    function updateLocationButtonLabel() {
      if (!locBtnLabel || !locationToggleBtn) return;
      const distVal = maxDistanceSelect ? maxDistanceSelect.value : '';
      const distSuffix = distVal ? ` (≤${distVal}km)` : '';

      if (activeLocationName) {
        locBtnLabel.textContent = `${activeLocationName}${distSuffix}`;
        locationToggleBtn.classList.add('active');
      } else if (distVal) {
        locBtnLabel.textContent = `≤${distVal}km`;
        locationToggleBtn.classList.add('active');
