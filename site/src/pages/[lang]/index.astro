    let userLat = null;
    let userLon = null;
    let cachedPlaces = null;

    // Normaliser (case- and diacritic-insensitive)
    function normalize(str) {
      if (!str) return '';
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    function resolveAliases(term) {
      const norm = normalize(term);
      for (const [alias, canonical] of Object.entries(cityAliases || {})) {
        if (normalize(alias) === norm) {
          return normalize(canonical);
        }
      }
      return norm;
    }

    // Client-side Haversine distance in km (§6.4)
    function haversineDistance(lat1, lon1, lat2, lon2) {
      const R = 6371; // Earth radius in km
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    // Lazy load places dataset
    async function loadPlaces() {
      if (cachedPlaces) return cachedPlaces;
      try {
        const res = await fetch('/data/places.json');
        if (res.ok) {
          cachedPlaces = await res.json();
          return cachedPlaces;
        }
      } catch (e) {}
      return [];
    }

    function findNearestPlace(lat, lon, placesList) {
      if (!placesList || placesList.length === 0) return null;
      let closest = null;
      let minD = Infinity;
      for (const p of placesList) {
        const d = haversineDistance(lat, lon, p[2], p[3]);
        if (d < minD) {
          minD = d;
          closest = { name: p[0], prov: p[1], dist: d };
        }
      }
      return closest;
    }

    // Geocoding: resolves town name or postal code (e.g. 8355, 1012 JS, Giethoorn)
    async function resolveLocationQuery(query) {
      const norm = normalize(query);
      if (!norm) return null;

      // 1. Try local places list first (fastest, 2,503 Dutch woonplaatsen)
      const placesList = await loadPlaces();
      const exactMatch = placesList.find((p) => normalize(p[0]) === norm);
      if (exactMatch) {
        return {
          name: exactMatch[0],
          prov: exactMatch[1],
          lat: exactMatch[2],
          lon: exactMatch[3],
        };
      }

      // Check if query starts with or contains place name (for multi-word or compound names)
      if (norm.length >= 3) {
        const prefixMatch = placesList.find((p) => normalize(p[0]).startsWith(norm));
        if (prefixMatch) {
          return {
            name: prefixMatch[0],
            prov: prefixMatch[1],
            lat: prefixMatch[2],
            lon: prefixMatch[3],
          };
        }
      }

      // 2. Query PDOK Locatieserver (handles postal codes like 8355, 1012 JS, and spelling variations)
      try {
        const pdokUrl = `https://api.pdok.nl/bzk/locatieserver/search/v3_1/free?q=${encodeURIComponent(query)}&rows=1&fq=type:(woonplaats%20OR%20postcode%20OR%20gemeente)`;
        const res = await fetch(pdokUrl);
        if (res.ok) {
          const data = await res.json();
          const doc = data.response?.docs?.[0];
          if (doc && doc.centroide_ll) {
            const match = doc.centroide_ll.match(/POINT\s*\(\s*([0-9.-]+)\s+([0-9.-]+)\s*\)/i);
            if (match) {
              const lon = parseFloat(match[1]);
              const lat = parseFloat(match[2]);
              const displayName = doc.woonplaatsnaam || doc.weergavenaam || query;
              const prov = doc.provincienaam || '';
              return {
                name: displayName,
                prov: prov,
                lat: lat,
                lon: lon,
              };
            }
          }
        }
      } catch (e) {}

      return null;
    }

    // Priority List storage helper
    function getPriorityList() {
      try {
        const raw = localStorage.getItem('museumwijzer_priority_list');
        const items = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(items)) return [];
        return items.map((item) => {
          if (typeof item === 'string') {
            return canonicalMapping[item] || item;
          }
          if (item && item.slug) {
            return { ...item, slug: canonicalMapping[item.slug] || item.slug };
          }
          return item;
        });
      } catch (e) {
        return [];
      }
    }

    function savePriorityList(list) {
