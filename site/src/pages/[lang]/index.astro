---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import yaml from 'yaml';
import Layout from '../../layouts/Layout.astro';
import { languages, type Locale } from '../../i18n/languages';
import { useTranslations } from '../../i18n/ui';
import museumsData from '../../../../data/museums.json';
import metaData from '../../../../data/meta.json';

const aliasesPath = fileURLToPath(new URL('../../../../data/city-aliases.yaml', import.meta.url));
const cityAliasesData = yaml.parse(fs.readFileSync(aliasesPath, 'utf-8')) || {};

export function getStaticPaths() {
  return [
    { params: { lang: 'nl' } },
    { params: { lang: 'en' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const museums = (museumsData.museums || []).filter((m: any) => m.status !== 'removed');

let formattedDate = 'onbekend';
if (metaData?.last_checked) {
  try {
    const d = new Date(metaData.last_checked);
    const dateLocales: Record<Locale, string> = {
      nl: 'nl-NL',
      en: 'en-GB',
      uk: 'uk-UA',
    };
    formattedDate = d.toLocaleDateString(dateLocales[lang] || 'nl-NL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    formattedDate = metaData.last_checked.slice(0, 10);
  }
}

function getCityAliases(m: any): string {
  const aliases: string[] = [];
  if (m.pdok_woonplaats && m.pdok_woonplaats !== m.city) {
    aliases.push(m.pdok_woonplaats);
  }
  const normCity = (m.city || '').toLowerCase().trim();
  for (const [alias, canonical] of Object.entries(cityAliasesData as Record<string, string>)) {
    if (canonical.toLowerCase().trim() === normCity) {
      aliases.push(alias);
    }
    if (alias.toLowerCase().trim() === normCity) {
      aliases.push(canonical);
    }
  }
  return aliases.join(', ');
}

// Collect unique provinces and cities for filter dropdowns
const provinces = Array.from(new Set(museums.map((m) => m.province).filter(Boolean))).sort();
const cities = Array.from(new Set(museums.map((m) => m.city).filter(Boolean))).sort();

// Pre-calculate city centroids for privacy-first distance fallback (§6.4)
const cityCentroids: Record<string, { lat: number; lon: number }> = {};
for (const city of cities) {
  const cityMuseums = museums.filter((m) => m.city === city && m.lat && m.lon);
  if (cityMuseums.length > 0) {
    const avgLat = cityMuseums.reduce((sum, m) => sum + (m.lat || 0), 0) / cityMuseums.length;
    const avgLon = cityMuseums.reduce((sum, m) => sum + (m.lon || 0), 0) / cityMuseums.length;
    cityCentroids[city] = { lat: Number(avgLat.toFixed(6)), lon: Number(avgLon.toFixed(6)) };
  }
}

const pageTitle =
  lang === 'nl'
    ? 'Deelnemende musea Welkom in het Museum'
    : lang === 'uk'
      ? 'Музеї-учасники програми «Ласкаво просимо до музею»'
      : 'Participating museums Welcome to the Museum';
---

<Layout title={pageTitle} locale={lang}>
  <div class="container">
    <!-- Hero / Explainer section (max 3 lines per §6.1) -->
    <section class="hero-section">
      <p class="hero-explainer">{t.explainer}</p>
      <div class="hero-cta">
        <a href={t.requestTicketsUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
          {t.requestTickets} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Search & Filter Controls -->
    <section class="search-section" aria-label="Museum search and filters">
      <div class="search-box">
        <label for="search-input" class="sr-only">{t.searchPlaceholder}</label>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder={t.searchPlaceholder}
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
        />
      </div>

      <div class="filter-controls">
        <div class="select-wrapper">
          <label for="province-select" class="sr-only">{t.filterByProvince}</label>
          <select id="province-select" class="filter-select">
            <option value="">{t.allProvinces}</option>
            {provinces.map((p) => <option value={p}>{p}</option>)}
          </select>
        </div>

        <div class="select-wrapper">
          <label for="city-select" class="sr-only">{t.filterByCity}</label>
          <select id="city-select" class="filter-select">
            <option value="">{t.allCities}</option>
            {cities.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>

        <div class="select-wrapper">
          <label for="max-distance-select" class="sr-only">{t.maxDistance}</label>
          <select id="max-distance-select" class="filter-select">
            <option value="">{t.allDistances}</option>
            <option value="10">{t.within10km}</option>
            <option value="25">{t.within25km}</option>
            <option value="50">{t.within50km}</option>
            <option value="100">{t.within100km}</option>
          </select>
        </div>

        <div class="select-wrapper">
          <label for="sort-select" class="sr-only">{t.sortBy}</label>
          <select id="sort-select" class="filter-select">
            <option value="name">{t.sortByName}</option>
            <option value="province">{t.sortByProvince}</option>
            <option value="distance" id="distance-sort-option" disabled>{t.sortByDistance}</option>
          </select>
        </div>

        <!-- Near Me Button (§6.4) -->
        <button type="button" id="near-me-btn" class="btn-near-me">
          <span aria-hidden="true">📍</span> <span id="near-me-text">{t.nearMeButton}</span>
        </button>

        <button type="button" id="clear-filters-btn" class="btn-secondary" style="display: none;">
          {t.clearFilters}
        </button>
      </div>

      <!-- Location Control Bar: Manual or Detected (§6.4) -->
      <div id="location-bar" class="location-bar">
        <!-- Idle state: Manual place/postcode input -->
        <div class="location-bar-idle" id="location-bar-idle">
          <label for="manual-location-input" class="location-label">
            <span>📍 {lang === 'nl' ? 'Locatie:' : (lang === 'uk' ? 'Локація:' : 'Location:')}</span>
          </label>
          <div class="manual-input-group">
            <input
              type="text"
              id="manual-location-input"
              class="manual-location-input"
              placeholder={t.manualLocationPlaceholder}
              aria-label={t.manualLocationPlaceholder}
              autocomplete="off"
            />
            <button type="button" id="manual-location-btn" class="btn-location-apply">
              {t.setLocationBtn}
            </button>
          </div>
        </div>

        <!-- Active state: displays detected GPS or manual place -->
        <div class="location-bar-active" id="location-bar-active" style="display: none;">
          <div class="location-active-info">
            <span class="location-pin-icon" aria-hidden="true">📍</span>
            <span id="location-active-text" class="location-active-text"></span>
          </div>
          <div class="location-active-actions">
            <button type="button" id="change-location-btn" class="btn-location-action">
              {t.changeLocation}
            </button>
            <button type="button" id="clear-location-btn" class="btn-location-action btn-location-danger">
              {t.allDistancesReset}
            </button>
          </div>
        </div>

        <!-- Inline error / warning message for location -->
        <div id="location-feedback-msg" class="location-feedback-msg" style="display: none;" role="alert"></div>
      </div>

      <!-- Result counter and status banner -->
      <div class="search-status" aria-live="polite">
        <span id="results-count" class="results-count">
          {t.resultsCount.replace('{count}', String(museums.length))}
        </span>
      </div>

      <!-- "Does X participate?" not found message box -->
      <div id="not-found-box" class="not-found-banner" style="display: none;">
        <h3 id="not-found-title" class="not-found-title">{t.notFoundTitle.replace('{date}', formattedDate)}</h3>
        <p id="not-found-text" class="not-found-desc">{t.notFoundText}</p>
        <div class="not-found-cta">
          <a href={t.officialListUrl} class="btn-outline" target="_blank" rel="noopener noreferrer">
            {t.checkOfficialList} ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Pre-rendered Museum Cards List (Progressive Enhancement) -->
    <section class="museums-grid" id="museums-list" aria-label="Participating museums">
      {
        museums.map((m) => (
          <article
            class="museum-card"
            data-slug={m.slug}
            data-name={m.name}
            data-province={m.province}
            data-city={m.city || ''}
            data-pdok-woonplaats={m.pdok_woonplaats || ''}
            data-city-aliases={getCityAliases(m)}
            data-street={m.address?.street || ''}
            data-postcode={m.address?.postcode || ''}
            data-lat={m.lat !== null && m.lat !== undefined ? String(m.lat) : ''}
            data-lon={m.lon !== null && m.lon !== undefined ? String(m.lon) : ''}
          >
            <div class="card-header">
              <div class="card-header-left">
                <span class="card-province">{m.province}</span>
              </div>
              <button
                type="button"
                class="card-list-btn"
                data-slug={m.slug}
                title={t.addToList}
                aria-label={t.addToList}
              >
                <span class="heart-icon" aria-hidden="true">🤍</span>
              </button>
            </div>

            <h2 class="card-title">
              <a href={`/${lang}/museum/${m.slug}/`}>{m.name}</a>
            </h2>

            <div class="card-meta">
              <div class="card-location-line">
                <span class="card-city">{m.city || 'Nederland'}</span>
                <span class="card-distance" style="display: none;"></span>
              </div>
              {m.address?.street && <span class="card-address">{m.address.street}</span>}
            </div>

            <div class="card-footer">
              <a href={`/${lang}/museum/${m.slug}/`} class="card-link">
                {t.viewDetails} →
              </a>
            </div>
          </article>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  .hero-section {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

