<script>
  import L from 'leaflet';

  function initDetailMap() {
    const mapEl = document.getElementById('detail-map');
    if (!mapEl) return;
    const lat = parseFloat(mapEl.dataset.lat || '0');
    const lon = parseFloat(mapEl.dataset.lon || '0');
    const name = mapEl.dataset.name || '';
    if (!lat || !lon) return;

    L.Icon.Default.imagePath = '/leaflet/images/';

    const map = L.map(mapEl, {
      center: [lat, lon],
      zoom: 14,
      scrollWheelZoom: false,
    });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    const marker = L.marker([lat, lon]).addTo(map);
    marker.bindPopup(`<strong>${name}</strong>`).openPopup();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDetailMap);
  } else {
    initDetailMap();
  }
</script>

<script is:inline define:vars={{
  slug: museum.slug,
  addText: t.addToList,
  inListText: t.inYourList,
  markVisitedText: t.markAsVisited,
  markNotVisitedText: t.markAsNotVisited,
  alreadyVisitedText: t.alreadyVisited
}}>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Visited Toggle Button
    const visitedBtn = document.getElementById('detail-visited-toggle-btn');
    if (visitedBtn) {
      function getVisited() {
        try {
          const raw = localStorage.getItem('museumwijzer_visited_museums');
          return raw ? JSON.parse(raw) : [];
        } catch (e) {
          return [];
        }
      }

      function saveVisited(list) {
        try {
          localStorage.setItem('museumwijzer_visited_museums', JSON.stringify(list));
        } catch (e) {}
      }

      function updateVisitedBtn() {
        const list = getVisited();
        const isVisited = list.includes(slug);
        visitedBtn.setAttribute('aria-pressed', isVisited ? 'true' : 'false');
        visitedBtn.classList.toggle('is-visited', isVisited);
        const textSpan = visitedBtn.querySelector('.visited-toggle-text');
        if (textSpan) {
          textSpan.textContent = isVisited ? alreadyVisitedText : markVisitedText;
        }
        visitedBtn.title = isVisited ? markNotVisitedText : markVisitedText;
      }

      visitedBtn.addEventListener('click', () => {
        let list = getVisited();
        const idx = list.indexOf(slug);
        if (idx >= 0) {
          list.splice(idx, 1);
        } else {
          list.push(slug);
        }
        saveVisited(list);
        updateVisitedBtn();
      });

      updateVisitedBtn();
    }

    // 2. Personal List Toggle Button
    const btn = document.getElementById('detail-list-toggle-btn');
    if (!btn) return;

    function getList() {
      try {
        const raw = localStorage.getItem('museumwijzer_priority_list');
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveList(list) {
      try {
        localStorage.setItem('museumwijzer_priority_list', JSON.stringify(list));
        // Update nav badge count
        const badge = document.getElementById('nav-list-count');
        if (badge) {
          badge.textContent = String(list.length);
          badge.style.display = list.length > 0 ? 'inline-flex' : 'none';
        }
      } catch (e) {}
    }

    function updateBtn() {
      const list = getList();
      const inList = list.some((item) => (typeof item === 'string' ? item : item.slug) === slug);
      btn.setAttribute('aria-pressed', inList ? 'true' : 'false');
      const textSpan = btn.querySelector('.toggle-text');
      const iconSpan = btn.querySelector('.toggle-icon');
      if (inList) {
        btn.classList.add('in-list');
        if (textSpan) textSpan.textContent = inListText;
        if (iconSpan) iconSpan.textContent = '❤️';
      } else {
        btn.classList.remove('in-list');
        if (textSpan) textSpan.textContent = addText;
        if (iconSpan) iconSpan.textContent = '🤍';
      }
    }

    btn.addEventListener('click', () => {
      let list = getList();
      const index = list.findIndex((item) => (typeof item === 'string' ? item : item.slug) === slug);
      if (index >= 0) {
        list.splice(index, 1);
      } else {
        list.push({ slug: slug, visited: false, note: '' });
      }
      saveList(list);
      updateBtn();
    });

    updateBtn();
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.getElementById('gallery-slider');
    if (!slider) return;

    const prevBtn = document.getElementById('gallery-btn-prev');
    const nextBtn = document.getElementById('gallery-btn-next');
    const dots = document.querySelectorAll('.gallery-dot');

    function updateDots() {
      if (!dots.length) return;
      const index = Math.round(slider.scrollLeft / slider.clientWidth);
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === index);
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        slider.scrollBy({ left: -slider.clientWidth, behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        slider.scrollBy({ left: slider.clientWidth, behavior: 'smooth' });
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-index'));
        slider.scrollTo({ left: idx * slider.clientWidth, behavior: 'smooth' });
      });
    });

    slider.addEventListener('scroll', () => {
      window.requestAnimationFrame(updateDots);
    });
  });
</script>
