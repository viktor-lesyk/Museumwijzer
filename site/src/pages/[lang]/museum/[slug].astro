---
import Layout from '../../../layouts/Layout.astro';
import { type Locale } from '../../../i18n/languages';
import { useTranslations } from '../../../i18n/ui';
import museumsData from '../../../../../data/museums.json';
import 'leaflet/dist/leaflet.css';

export function getStaticPaths() {
  const locales: Locale[] = ['nl', 'en', 'uk'];
  const paths = [];
  const activeMuseums = museumsData.museums.filter((m: any) => m.status !== 'removed');
  for (const lang of locales) {
    for (const museum of activeMuseums) {
      paths.push({
        params: { lang, slug: museum.slug },
        props: { museum },
      });
      // Also generate lowercase route alias for slugs with uppercase letters (e.g. Museum-Tromps-Huys)
      const lowerSlug = museum.slug.toLowerCase();
      if (lowerSlug !== museum.slug) {
        paths.push({
          params: { lang, slug: lowerSlug },
          props: { museum },
        });
      }
    }
  }
  return paths;
}

interface Props {
  museum: (typeof museumsData.museums)[0];
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const { museum } = Astro.props;
const t = useTranslations(lang);

// Localized official URL
const officialUrl = museum.official_urls?.[lang] || museum.official_url;

// Directions and map links
const googleMapsQuery = encodeURIComponent(
  `${museum.name}, ${museum.address?.street ? museum.address.street + ', ' : ''}${museum.city || ''}`
);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${googleMapsQuery}`;
const appleMapsUrl = `https://maps.apple.com/?q=${googleMapsQuery}${museum.lat && museum.lon ? `&ll=${museum.lat},${museum.lon}` : ''}`;

const osmUrl =
  museum.lat && museum.lon
    ? `https://www.openstreetmap.org/?mlat=${museum.lat}&mlon=${museum.lon}#map=16/${museum.lat}/${museum.lon}`
    : null;

const linksHeading =
  lang === 'nl'
    ? 'Links & Kaarten'
    : lang === 'uk'
      ? 'Посилання та квитки'
      : 'Links & Tickets';

const canonicalPath = (museum as any).duplicate_of ? `/${lang}/museum/${(museum as any).duplicate_of}/` : '';

import pricesData from '../../../../../data/enrichment/prices.json';
import {
  formatPriceNumber,
  formatCheckedDate,
  formatVariantLabel,
  getReportWrongPriceUrl,
  type PriceRecord
} from '../../../utils/price';

const pricesMap: Record<string, PriceRecord> = {};
for (const p of (pricesData.museums || [])) {
  if (p.slug && p.price) {
    pricesMap[p.slug] = p.price;
  }
}
const priceObj = pricesMap[museum.slug] || ((museum as any).duplicate_of ? pricesMap[(museum as any).duplicate_of] : undefined);
---

<Layout title={`${museum.name} — ${museum.city || 'Nederland'}`} locale={lang} canonicalPath={canonicalPath}>
  {(museum as any).duplicate_of && (
    <meta http-equiv="refresh" content={`0;url=/${lang}/museum/${(museum as any).duplicate_of}/`} slot="head" />
  )}
  <div class="container">
    {(museum as any).duplicate_of && (
      <div class="duplicate-banner" style="background:#fff3cd; color:#856404; padding:0.75rem 1rem; border-radius:6px; margin-bottom:1rem; border:1px solid #ffeeba;">
        <p style="margin:0;">
          {lang === 'nl'
            ? `Let op: dit is een dubbele vermelding. Bekijk de officiële pagina: `
            : `Notice: this is a duplicate listing. View the canonical page: `}
          <a href={`/${lang}/museum/${(museum as any).duplicate_of}/`} style="font-weight:bold; color:inherit; text-decoration:underline;">
            {museum.name}
          </a>
        </p>
      </div>
    )}
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={`/${lang}/`} class="back-link">{t.backToFinder}</a>
    </nav>

    <article class="museum-detail-card">
      <header class="detail-header">
        <div class="detail-header-top">
          <div class="detail-badges">
            <span class="detail-province">{museum.province}</span>
          </div>

          <!-- Add / Remove from personal list button -->
          <button
            type="button"
            id="detail-list-toggle-btn"
            class="btn-list-toggle"
            data-slug={museum.slug}
            aria-pressed="false"
          >
            <span class="toggle-icon" aria-hidden="true">🤍</span>
            <span class="toggle-text">{t.addToList}</span>
          </button>
        </div>

        <h1 class="detail-title">{museum.name}</h1>
      </header>

      <!-- Factual closure / opening hours advisory -->
      <div class="closure-notice">
        <span class="notice-icon" aria-hidden="true">ℹ️</span>
        <p class="notice-text">{t.checkOpeningHours}</p>
      </div>

      <section class="detail-info-grid">
        <div class="info-card">
          <h2 class="info-heading">{t.address}</h2>
          <div class="address-details">
            {museum.address?.street && <p class="street-line">{museum.address.street}</p>}
            <p class="city-line">
              {museum.address?.postcode && <span class="postcode">{museum.address.postcode} </span>}
              <span class="city-name">{museum.city}</span>
            </p>
            {museum.province && <p class="province-line">{t.province}: {museum.province}</p>}
            {museum.municipality && museum.municipality !== museum.city && (
              <p class="municipality-line">{t.municipality}: {museum.municipality}</p>
            )}
          </div>

          {museum.lat && museum.lon && (
            <div class="map-embed-wrapper">
              <div
                id="detail-map"
                class="detail-map"
                data-lat={museum.lat}
                data-lon={museum.lon}
                data-name={museum.name}
              ></div>
            </div>
          )}

          <div class="map-links-container">
            <a href={googleMapsUrl} class="btn-map" target="_blank" rel="noopener noreferrer">
              📍 {t.openInGoogleMaps} ↗
            </a>
            <a href={appleMapsUrl} class="btn-map" target="_blank" rel="noopener noreferrer">
              🧭 {t.openInAppleMaps} ↗
            </a>
            {osmUrl && (
              <a href={osmUrl} class="btn-map" target="_blank" rel="noopener noreferrer">
                🗺️ {t.openInOsm} ↗
              </a>
            )}
          </div>
        </div>

        <div class="info-card price-card">
          <h2 class="info-heading">{t.regularAdmission}</h2>
          <div class="price-details">
            <div class="price-primary">
              {priceObj && priceObj.status === 'paid' && priceObj.primary_adult_eur !== null ? (
                <span class="price-val-large">{t.priceFrom.replace('{price}', formatPriceNumber(priceObj.primary_adult_eur, lang))}</span>
              ) : priceObj && priceObj.status === 'free' ? (
                <span class="price-badge-free-large">{t.priceFree}</span>
              ) : priceObj && priceObj.status === 'closed' ? (
                <span class="price-badge-closed-large">{t.priceClosed}</span>
              ) : (
                <span class="price-badge-check-large">{t.priceCheckWebsite}</span>
              )}
            </div>

            {priceObj && priceObj.status === 'paid' && priceObj.online_adult_eur !== null && priceObj.door_adult_eur !== null && priceObj.online_adult_eur !== priceObj.door_adult_eur && (
              <p class="price-split-line">
                {t.priceOnlineDoor
                  .replace('{online}', formatPriceNumber(priceObj.online_adult_eur, lang))
                  .replace('{door}', formatPriceNumber(priceObj.door_adult_eur, lang))}
              </p>
            )}

            {priceObj && priceObj.variants && Object.keys(priceObj.variants).length > 0 && (
              <div class="price-variants-block">
                {Object.entries(priceObj.variants).map(([vKey, vVal]) => (
                  <p class="variant-line">
                    <span class="variant-label">{formatVariantLabel(vKey, lang)}:</span>{' '}
                    <span class="variant-amount">€{formatPriceNumber(vVal, lang)}</span>
                  </p>
                ))}
              </div>
            )}

            {priceObj && priceObj.price_note && (
              <p class="price-note-line">
                <em>{priceObj.price_note}</em>
              </p>
            )}

            {priceObj && (priceObj.checked_on || priceObj.source_url) && (
              <div class="price-meta-line">
                {priceObj.checked_on && priceObj.source_url ? (
                  <a href={priceObj.source_url} class="price-source-link" target="_blank" rel="noopener noreferrer">
                    {t.priceCheckedDate.replace('{date}', formatCheckedDate(priceObj.checked_on, lang))} ↗
                  </a>
                ) : priceObj.checked_on ? (
                  <span>{t.priceCheckedDate.replace('{date}', formatCheckedDate(priceObj.checked_on, lang))}</span>
                ) : null}
                <span class="price-meta-sep">·</span>
                <a href={getReportWrongPriceUrl(museum.name, museum.slug, priceObj.source_url, lang)} class="price-report-link">
                  {t.reportWrongPrice}
                </a>
              </div>
            )}
          </div>
        </div>

        <div class="info-card links-card">
          <h2 class="info-heading">{linksHeading}</h2>
          <ul class="action-links">
            <li>
              <a href={officialUrl} class="link-item primary-link" target="_blank" rel="noopener noreferrer">
                <span>{t.officialCampaignPage}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>

            {museum.museum_website && (
              <li>
                <a href={museum.museum_website} class="link-item secondary-link" target="_blank" rel="noopener noreferrer">
                  <span>{t.museumWebsite}</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            )}

            <li>
              <a href={t.requestTicketsUrl} class="link-item ticket-link" target="_blank" rel="noopener noreferrer">
                <span>{t.requestTickets}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </div>
      </section>
    </article>
  </div>
</Layout>

<style>
