  /* Admission price card styles */
  .price-card {
    display: flex;
    flex-direction: column;
  }

  .price-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .price-primary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .price-val-large {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .price-badge-free-large {
    font-size: 1.3rem;
    font-weight: 700;
    color: #166534;
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius);
  }

  .price-badge-closed-large {
    font-size: 1.2rem;
    font-weight: 700;
    color: #991b1b;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius);
  }

  .price-badge-check-large {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .price-split-line {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    padding: 0.4rem 0.65rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    display: inline-block;
    width: fit-content;
  }

  .price-variants-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.25rem;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-surface);
    border-left: 3px solid var(--color-border);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.875rem;
  }

  .variant-line {
    margin: 0;
    color: var(--color-text-muted);
  }

  .variant-label {
    font-weight: 500;
  }

  .variant-amount {
    font-weight: 600;
    color: var(--color-text);
  }

  .price-note-line {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .price-meta-line {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-light);
  }

  .price-source-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }

  .price-source-link:hover {
