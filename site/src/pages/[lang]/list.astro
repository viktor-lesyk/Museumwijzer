  /* Print Stylesheet */
  @media print {
    .toolbar-actions, .shared-list-card, .toast-message, .empty-state-box, .reorder-btns, .btn-item-delete, .drag-grip, .btn-open-note, .note-memo-actions {
      display: none !important;
