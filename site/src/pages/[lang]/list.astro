    gap: 0.25rem;
  }

  .btn-note-subtle {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    transition: all 0.15s ease;
  }

  .btn-note-subtle:hover {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .note-edit-form {
