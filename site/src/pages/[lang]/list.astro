</style>

<script is:inline define:vars={{
  lookup: museumsLookup,
  lang: lang,
  emptyNoticeText: t.emptyListNotice,
  visitedText: t.visitedCheckbox,
  hideVisitedText: t.hideVisited,
  showVisitedText: t.showVisited,
  visitedHiddenNoticeTemplate: t.visitedHiddenNotice,
  notePlaceholder: t.personalNotePlaceholder,
  moveUpText: t.moveUp,
  moveDownText: t.moveDown,
  removeText: t.removeFromList,
  noLongerListedText: t.noLongerListed,
  clearConfirmText: t.clearListConfirm,
  addNoteText: t.addNote,
  saveNoteText: t.saveNote,
  cancelNoteText: t.cancelNote,
  deleteNoteText: t.deleteNote,
  canonicalMapping: canonicalMapping
}}>
  document.addEventListener('DOMContentLoaded', () => {
    const itemsListEl = document.getElementById('priority-items-list');
    const emptyNoticeEl = document.getElementById('empty-list-notice');
    const statsBadgeEl = document.getElementById('list-stats-badge');
    const sharedBannerEl = document.getElementById('shared-list-banner');
    const saveSharedBtn = document.getElementById('save-shared-list-btn');
    const dismissSharedBtn = document.getElementById('dismiss-shared-list-btn');
    const shareBtn = document.getElementById('share-list-btn');
    const shareToast = document.getElementById('share-toast');
    const exportCsvBtn = document.getElementById('export-csv-btn');
    const exportJsonBtn = document.getElementById('export-json-btn');
    const importInput = document.getElementById('import-json-input');
    const printBtn = document.getElementById('print-list-btn');
    const clearBtn = document.getElementById('clear-list-btn');
    const toggleHideVisitedBtn = document.getElementById('toggle-hide-visited-btn');
    const hideVisitedBtnText = document.getElementById('hide-visited-btn-text');
    const visitedHiddenBanner = document.getElementById('visited-hidden-banner');
    const visitedHiddenCountText = document.getElementById('visited-hidden-count-text');
    const showVisitedInlineBtn = document.getElementById('show-visited-inline-btn');

    let currentList = [];
    let sharedSlugs = null;
    let hideVisited = false;
    try {
      hideVisited = localStorage.getItem('museumwijzer_hide_visited_list') === 'true';
    } catch(e) {}

    function loadSavedList() {
      try {
        const raw = localStorage.getItem('museumwijzer_priority_list');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) {
            const seen = new Set();
            return parsed.map((item) => {
              const rawSlug = typeof item === 'string' ? item : (item.slug || '');
              const resolved = canonicalMapping[rawSlug] || rawSlug;
              if (typeof item === 'string') {
                return { slug: resolved, visited: false, note: '' };
              }
              return {
                slug: resolved,
                visited: Boolean(item.visited),
                note: item.note || '',
              };
            }).filter((item) => {
              if (!item.slug || seen.has(item.slug)) return false;
              seen.add(item.slug);
              return true;
            });
          }
        }
      } catch (e) {}
      return [];
    }

    function saveListToStorage(list) {
      currentList = list;
      try {
        localStorage.setItem('museumwijzer_priority_list', JSON.stringify(list));
        const badge = document.getElementById('nav-list-count');
        if (badge) {
          badge.textContent = String(list.length);
          badge.style.display = list.length > 0 ? 'inline-flex' : 'none';
        }
      } catch (e) {}
    }

    function updateStatsBadge() {
      if (!statsBadgeEl) return;
      const count = currentList.length;
      if (count === 0) {
        statsBadgeEl.style.display = 'none';
        return;
      }
      const visitedCount = currentList.filter((item) => item.visited).length;
      if (lang === 'nl') {
        statsBadgeEl.textContent = `${count} ${count === 1 ? 'museum' : 'musea'}${visitedCount > 0 ? ` • ${visitedCount} bezocht` : ''}`;
      } else if (lang === 'uk') {
        statsBadgeEl.textContent = `${count} ${count === 1 ? 'музей' : 'музеїв'}${visitedCount > 0 ? ` • ${visitedCount} відвідано` : ''}`;
      } else {
        statsBadgeEl.textContent = `${count} ${count === 1 ? 'museum' : 'museums'}${visitedCount > 0 ? ` • ${visitedCount} visited` : ''}`;
      }
      statsBadgeEl.style.display = 'inline-flex';
    }

    // Check URL hash for shared list (#list=slug1,slug2,...)
    function checkSharedHash() {
      const hash = window.location.hash || '';
      if (hash.startsWith('#list=')) {
        const seen = new Set();
        const rawSlugs = hash.slice(6).split(',').map((s) => {
          const decoded = decodeURIComponent(s.trim());
          return canonicalMapping[decoded] || decoded;
        }).filter((slug) => {
          if (!slug || seen.has(slug)) return false;
          seen.add(slug);
          return true;
        });
        if (rawSlugs.length > 0) {
          const currentSlugs = currentList.map((item) => item.slug).join(',');
          const incomingSlugs = rawSlugs.join(',');
          if (currentSlugs !== incomingSlugs) {
            sharedSlugs = rawSlugs;
            sharedBannerEl.style.display = 'flex';
            if (currentList.length === 0) {
              currentList = sharedSlugs.map((slug) => ({ slug: slug, visited: false, note: '' }));
            }
          }
        }
      }
    }

    function renderList() {
      itemsListEl.innerHTML = '';
      updateStatsBadge();

      const visitedCount = currentList.filter((item) => item.visited).length;

      // Update Toolbar Hide Visited Button
      if (toggleHideVisitedBtn) {
        if (visitedCount === 0) {
          toggleHideVisitedBtn.style.display = 'none';
        } else {
          toggleHideVisitedBtn.style.display = 'inline-flex';
          if (hideVisited) {
            toggleHideVisitedBtn.classList.add('active');
            toggleHideVisitedBtn.setAttribute('aria-pressed', 'true');
            if (hideVisitedBtnText) hideVisitedBtnText.textContent = `${showVisitedText} (${visitedCount})`;
          } else {
            toggleHideVisitedBtn.classList.remove('active');
            toggleHideVisitedBtn.setAttribute('aria-pressed', 'false');
            if (hideVisitedBtnText) hideVisitedBtnText.textContent = `${hideVisitedText} (${visitedCount})`;
          }
        }
      }

      if (currentList.length === 0) {
        emptyNoticeEl.style.display = 'flex';
        itemsListEl.style.display = 'none';
        if (visitedHiddenBanner) visitedHiddenBanner.style.display = 'none';
        return;
      }

      emptyNoticeEl.style.display = 'none';
      itemsListEl.style.display = 'flex';

      const visibleList = hideVisited ? currentList.filter((item) => !item.visited) : currentList;

      // Visited hidden bottom banner
      if (visitedHiddenBanner) {
        if (hideVisited && visitedCount > 0) {
          visitedHiddenBanner.style.display = 'flex';
          if (visitedHiddenCountText) {
            visitedHiddenCountText.textContent = visitedHiddenNoticeTemplate.replace('{count}', String(visitedCount));
          }
        } else {
          visitedHiddenBanner.style.display = 'none';
        }
      }

      visibleList.forEach((item, visibleIndex) => {
        const fullIndex = currentList.indexOf(item);
        const slug = item.slug;
        const museum = lookup[slug];

        const card = document.createElement('li');
        card.className = 'priority-item-card' + (item.visited ? ' is-visited' : '');
        card.setAttribute('draggable', 'true');
        card.dataset.index = String(fullIndex);
        card.dataset.slug = slug;

        // Top Row
        const topRow = document.createElement('div');
        topRow.className = 'card-top-row';

        // Left Col: Controls, Thumbnail, Info
        const leftCol = document.createElement('div');
        leftCol.className = 'card-left-col';

        // Controls (Grip, Check circle, Rank)
        const controlsCol = document.createElement('div');
        controlsCol.className = 'card-controls-col';

        // Drag grip
        const grip = document.createElement('span');
        grip.className = 'drag-grip';
        grip.setAttribute('aria-hidden', 'true');
        grip.title = 'Versleep om te herschikken';
        grip.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
            <circle cx="5" cy="3" r="1.5"/><circle cx="11" cy="3" r="1.5"/>
            <circle cx="5" cy="8" r="1.5"/><circle cx="11" cy="8" r="1.5"/>
            <circle cx="5" cy="13" r="1.5"/><circle cx="11" cy="13" r="1.5"/>
          </svg>
        `;
        controlsCol.appendChild(grip);

        // Circular Check Button
        const checkBtn = document.createElement('button');
        checkBtn.type = 'button';
        checkBtn.className = 'btn-check-circle';
        checkBtn.title = visitedText;
        checkBtn.setAttribute('aria-pressed', item.visited ? 'true' : 'false');
        checkBtn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        `;
        checkBtn.addEventListener('click', () => {
          item.visited = !item.visited;
          saveListToStorage(currentList);
          renderList();
        });
        controlsCol.appendChild(checkBtn);

        // Rank indicator
        const rank = document.createElement('span');
        rank.className = 'rank-badge';
        rank.textContent = `${fullIndex + 1}`;
        controlsCol.appendChild(rank);
        leftCol.appendChild(controlsCol);

        // Small Thumbnail Image
        const thumbWrap = document.createElement('div');
        thumbWrap.className = 'card-thumb-wrap';
        if (museum && museum.image) {
          const img = document.createElement('img');
          img.src = museum.image;
          img.alt = '';
          img.className = 'card-thumb-img';
          img.loading = 'lazy';
          thumbWrap.appendChild(img);
        } else {
          thumbWrap.classList.add('card-thumb-empty');
          thumbWrap.innerHTML = '🏛️';
        }
        leftCol.appendChild(thumbWrap);

        // Info (title, badges, ratings & categories)
        const info = document.createElement('div');
        info.className = 'item-info';

        const title = document.createElement('h2');
        title.className = 'item-title';

        if (museum && museum.status !== 'removed') {
          const link = document.createElement('a');
          link.href = `/${lang}/museum/${slug}/`;
          link.textContent = museum.name;
          title.appendChild(link);
          info.appendChild(title);

          const badges = document.createElement('div');
          badges.className = 'item-badges';

          const locText = museum.city ? (museum.province ? `${museum.city}, ${museum.province}` : museum.city) : (museum.province || '');
          if (locText) {
            const locSpan = document.createElement('span');
            locSpan.className = 'city-tag';
            locSpan.textContent = locText;
            badges.appendChild(locSpan);
          }
          if (museum.street) {
            const streetSpan = document.createElement('span');
            streetSpan.className = 'street-tag';
            streetSpan.textContent = museum.street;
            badges.appendChild(streetSpan);
          }
          info.appendChild(badges);

          // Ratings & Categories row
          const metaRow = document.createElement('div');
          metaRow.className = 'item-meta-row';

          if (museum.rating) {
            const rTag = document.createElement('span');
            rTag.className = 'item-rating-badge';
            rTag.innerHTML = `⭐ <strong>${museum.rating}</strong>${museum.reviewsFormatted ? ` <span class="rating-count">(${museum.reviewsFormatted})</span>` : ''}`;
            metaRow.appendChild(rTag);
          }

          if (museum.categories && museum.categories.length > 0) {
            const catGroup = document.createElement('div');
            catGroup.className = 'item-category-pills';
            museum.categories.slice(0, 2).forEach((cat) => {
              const cPill = document.createElement('span');
              cPill.className = 'item-cat-pill';
              cPill.textContent = cat.label;
              catGroup.appendChild(cPill);
            });
            metaRow.appendChild(catGroup);
          }

          if (metaRow.children.length > 0) {
            info.appendChild(metaRow);
          }
        } else {
          title.textContent = museum ? museum.name : slug;
          info.appendChild(title);

          const unlisted = document.createElement('span');
          unlisted.className = 'unlisted-badge';
          unlisted.textContent = `⚠️ ${noLongerListedText}`;
          info.appendChild(unlisted);
        }

        leftCol.appendChild(info);
        topRow.appendChild(leftCol);

        // Right Col: Up/Down buttons, Delete Trash button
        const rightCol = document.createElement('div');
        rightCol.className = 'card-right-col';

        // Reorder chevrons
        const reorderBox = document.createElement('div');
        reorderBox.className = 'reorder-btns';

        const upBtn = document.createElement('button');
        upBtn.type = 'button';
        upBtn.className = 'btn-step';
        upBtn.title = moveUpText;
        upBtn.disabled = visibleIndex === 0;
        upBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        `;
        upBtn.addEventListener('click', () => {
          if (visibleIndex > 0) {
            const prevItem = visibleList[visibleIndex - 1];
            const prevFullIdx = currentList.indexOf(prevItem);
            currentList.splice(fullIndex, 1);
            currentList.splice(prevFullIdx, 0, item);
            saveListToStorage(currentList);
            renderList();
          }
        });
        reorderBox.appendChild(upBtn);

        const downBtn = document.createElement('button');
        downBtn.type = 'button';
        downBtn.className = 'btn-step';
        downBtn.title = moveDownText;
        downBtn.disabled = visibleIndex === visibleList.length - 1;
        downBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        `;
        downBtn.addEventListener('click', () => {
          if (visibleIndex < visibleList.length - 1) {
            const nextItem = visibleList[visibleIndex + 1];
            const nextFullIdx = currentList.indexOf(nextItem);
            currentList.splice(fullIndex, 1);
            currentList.splice(nextFullIdx, 0, item);
            saveListToStorage(currentList);
            renderList();
          }
        });
        reorderBox.appendChild(downBtn);
        rightCol.appendChild(reorderBox);

        // Delete Trash Button
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-item-delete';
        delBtn.title = removeText;
        delBtn.setAttribute('aria-label', removeText);
        delBtn.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
        `;
        delBtn.addEventListener('click', () => {
          currentList.splice(fullIndex, 1);
          saveListToStorage(currentList);
          renderList();
        });
        rightCol.appendChild(delBtn);

        topRow.appendChild(rightCol);
        card.appendChild(topRow);

        // Note Section: Memo card or Add Note button
        const noteSection = document.createElement('div');
        noteSection.className = 'card-note-section';

        if (item.note) {
          const memoCard = document.createElement('div');
          memoCard.className = 'note-memo-card';

          const textSpan = document.createElement('span');
          textSpan.className = 'note-memo-text';
          textSpan.textContent = `“${item.note}”`;
          memoCard.appendChild(textSpan);

          const actions = document.createElement('div');
          actions.className = 'note-memo-actions';

          const editBtn = document.createElement('button');
          editBtn.type = 'button';
          editBtn.className = 'btn-note-subtle';
          editBtn.title = 'Notitie bewerken';
          editBtn.innerHTML = `
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
          `;
          editBtn.addEventListener('click', () => {
            showNoteEditor(noteSection, item);
          });
          actions.appendChild(editBtn);

          const removeNoteBtn = document.createElement('button');
          removeNoteBtn.type = 'button';
          removeNoteBtn.className = 'btn-note-subtle';
          removeNoteBtn.title = deleteNoteText;
          removeNoteBtn.innerHTML = `
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          `;
          removeNoteBtn.addEventListener('click', () => {
            item.note = '';
            saveListToStorage(currentList);
            renderList();
          });
          actions.appendChild(removeNoteBtn);

          memoCard.appendChild(actions);
          noteSection.appendChild(memoCard);
        } else {
          const addBtn = document.createElement('button');
          addBtn.type = 'button';
          addBtn.className = 'btn-open-note';
          addBtn.innerHTML = `
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>${addNoteText}</span>
          `;
          addBtn.addEventListener('click', () => {
            showNoteEditor(noteSection, item);
          });
          noteSection.appendChild(addBtn);
        }

        card.appendChild(noteSection);

        // Drag and drop handlers
        card.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', String(fullIndex));
          card.classList.add('is-dragging');
        });
        card.addEventListener('dragend', () => {
          card.classList.remove('is-dragging');
          document.querySelectorAll('.priority-item-card').forEach((el) => el.classList.remove('is-drag-over'));
        });
        card.addEventListener('dragover', (e) => {
          e.preventDefault();
          card.classList.add('is-drag-over');
        });
        card.addEventListener('dragleave', () => {
          card.classList.remove('is-drag-over');
        });
        card.addEventListener('drop', (e) => {
          e.preventDefault();
          card.classList.remove('is-drag-over');
          const fromIndex = parseInt(e.dataTransfer.getData('text/plain'), 10);
          const toIndex = fullIndex;
          if (!isNaN(fromIndex) && fromIndex !== toIndex) {
            const [moved] = currentList.splice(fromIndex, 1);
            currentList.splice(toIndex, 0, moved);
            saveListToStorage(currentList);
            renderList();
          }
        });

        itemsListEl.appendChild(card);
      });
    }

    function showNoteEditor(containerEl, item) {
      containerEl.innerHTML = '';
      const form = document.createElement('form');
      form.className = 'note-edit-form';

      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'note-edit-input';
      input.placeholder = notePlaceholder;
      input.value = item.note || '';

      const saveBtn = document.createElement('button');
      saveBtn.type = 'submit';
      saveBtn.className = 'btn-note-save';
      saveBtn.textContent = saveNoteText;

      const cancelBtn = document.createElement('button');
      cancelBtn.type = 'button';
      cancelBtn.className = 'btn-note-cancel';
      cancelBtn.textContent = cancelNoteText;

      form.appendChild(input);
      form.appendChild(saveBtn);
      form.appendChild(cancelBtn);

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        item.note = input.value.trim();
        saveListToStorage(currentList);
        renderList();
      });

      cancelBtn.addEventListener('click', () => {
        renderList();
      });

      containerEl.appendChild(form);
      input.focus();
    }

    // Save shared list
    saveSharedBtn.addEventListener('click', () => {
      if (sharedSlugs && sharedSlugs.length > 0) {
        const savedList = loadSavedList();
        const mergedList = sharedSlugs.map((slug) => {
          const existing = savedList.find((item) => item.slug === slug);
          return existing || { slug: slug, visited: false, note: '' };
        });
        saveListToStorage(mergedList);
        sharedBannerEl.style.display = 'none';
        history.replaceState(null, '', window.location.pathname);
        renderList();
      }
    });

    dismissSharedBtn.addEventListener('click', () => {
      sharedBannerEl.style.display = 'none';
      history.replaceState(null, '', window.location.pathname);
      currentList = loadSavedList();
      renderList();
    });

    // Share link
    shareBtn.addEventListener('click', () => {
      const slugs = currentList.map((item) => encodeURIComponent(item.slug)).join(',');
      const shareUrl = `${window.location.origin}${window.location.pathname}#list=${slugs}`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        shareToast.style.display = 'flex';
        setTimeout(() => {
          shareToast.style.display = 'none';
        }, 3000);
      }).catch(() => {
        prompt('Kopieer deellink:', shareUrl);
      });
    });

    // Export CSV
    exportCsvBtn.addEventListener('click', () => {
      if (currentList.length === 0) return;
      const headers = ['Rank', 'Slug', 'Name', 'City', 'Province', 'Visited', 'Note', 'Website'];
      const rows = currentList.map((item, idx) => {
        const m = lookup[item.slug];
        const escapeCsv = (str) => `"${String(str || '').replace(/"/g, '""')}"`;
        return [
          idx + 1,
          escapeCsv(item.slug),
          escapeCsv(m ? m.name : item.slug),
          escapeCsv(m ? m.city : ''),
          escapeCsv(m ? m.province : ''),
          item.visited ? 'Yes' : 'No',
          escapeCsv(item.note || ''),
          escapeCsv(m ? m.website || '' : ''),
        ].join(',');
      });
      const csvContent = '\uFEFF' + [headers.join(','), ...rows].join('\r\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `museumwijzer-prioriteitenlijst-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Export JSON
    exportJsonBtn.addEventListener('click', () => {
      if (currentList.length === 0) return;
      const exportData = {
        version: '1.0',
        exported_at: new Date().toISOString(),
        items: currentList.map((item) => ({
          slug: item.slug,
          visited: item.visited,
          note: item.note,
          name: lookup[item.slug]?.name || item.slug,
        })),
      };
      const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `museumwijzer-prioriteitenlijst-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Import JSON
    importInput.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const parsed = JSON.parse(event.target.result);
          let items = [];
          if (Array.isArray(parsed)) {
            items = parsed;
          } else if (parsed && Array.isArray(parsed.items)) {
            items = parsed.items;
          }
          if (items.length > 0) {
            const importedList = items.map((it) => {
              if (typeof it === 'string') return { slug: it, visited: false, note: '' };
              return {
                slug: it.slug || '',
                visited: Boolean(it.visited),
                note: it.note || '',
              };
            }).filter((it) => it.slug);

            saveListToStorage(importedList);
            renderList();
          }
        } catch (err) {
          alert('Fout bij importeren van JSON-bestand.');
        }
      };
      reader.readAsText(file);
      importInput.value = '';
    });

    // Print
    printBtn.addEventListener('click', () => {
      window.print();
    });

    // Toggle Hide Visited
    if (toggleHideVisitedBtn) {
      toggleHideVisitedBtn.addEventListener('click', () => {
        hideVisited = !hideVisited;
        try {
          localStorage.setItem('museumwijzer_hide_visited_list', String(hideVisited));
        } catch (e) {}
        renderList();
      });
    }

    if (showVisitedInlineBtn) {
      showVisitedInlineBtn.addEventListener('click', () => {
        hideVisited = false;
        try {
          localStorage.setItem('museumwijzer_hide_visited_list', 'false');
        } catch (e) {}
        renderList();
      });
    }

    // Clear list
    clearBtn.addEventListener('click', () => {
      if (confirm(clearConfirmText)) {
        saveListToStorage([]);
        renderList();
      }
    });

    // Initial load
    currentList = loadSavedList();
    checkSharedHash();
    renderList();
  });
</script>
