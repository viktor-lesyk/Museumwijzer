---
import Layout from '../../layouts/Layout.astro';
import { type Locale } from '../../i18n/languages';
import { useTranslations, getCategoryLabel } from '../../i18n/ui';
import museumsData from '../../../../data/museums.json';
import descriptionsData from '../../../../data/enrichment/descriptions.json';
import { getMuseumRating, formatReviewsCount } from '../../utils/rating';

export function getStaticPaths() {
  return [
    { params: { lang: 'nl' } },
    { params: { lang: 'en' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const allMuseums = museumsData.museums || [];
const canonicalMapping: Record<string, string> = {};
for (const m of allMuseums) {
  if ((m as any).duplicate_of) {
    canonicalMapping[m.slug] = (m as any).duplicate_of;
  }
}

const descriptionsMap: Record<string, any> = {};
for (const d of (descriptionsData.museums || [])) {
  if (d.slug) {
    descriptionsMap[d.slug] = d;
  }
}

// Compact lookup dictionary for client-side rendering
const museumsLookup: Record<string, {
  name: string;
  city: string;
  province: string;
  street: string;
  website: string | null;
  status: string;
  image: string | null;
  rating: number | null;
  reviews: number | null;
  reviewsFormatted: string | null;
  categories: { key: string; label: string }[];
}> = {};

for (const m of allMuseums) {
  const desc = descriptionsMap[m.slug];
  const r = getMuseumRating(m.slug);
  const cats = (desc?.categories || []).map((k: string) => ({
    key: k,
    label: getCategoryLabel(k, lang),
  }));

  museumsLookup[m.slug] = {
    name: m.name,
    city: m.city || '',
    province: m.province || '',
    street: m.address?.street || '',
    website: m.museum_website || null,
    status: (m as any).status || 'active',
    image: desc?.image?.url || desc?.images?.[0]?.url || null,
    rating: r.rating,
    reviews: r.reviews,
    reviewsFormatted: r.reviews ? formatReviewsCount(r.reviews) : null,
    categories: cats,
  };
}
---

<Layout title={t.myListTitle} locale={lang}>
  <div class="container list-container">
    <!-- Header Section -->
    <header class="list-page-header">
      <div class="header-main">
        <div class="title-row">
          <h1 class="page-title">{t.myListTitle}</h1>
          <span id="list-stats-badge" class="stats-badge" style="display: none;"></span>
        </div>
        <p class="page-subtitle">{t.myListSubtitle}</p>
        <p class="storage-notice">
          <span class="storage-notice-icon" aria-hidden="true">💾</span>
          {t.listStorageNotice}
        </p>
      </div>

      <!-- Action Toolbar -->
      <div class="toolbar-actions" role="toolbar" aria-label="Lijst acties">
        <button type="button" id="share-list-btn" class="btn-action btn-action-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
            <polyline points="16 6 12 2 8 6"></polyline>
            <line x1="12" y1="2" x2="12" y2="15"></line>
          </svg>
          <span>{t.shareList}</span>
        </button>

        <button type="button" id="print-list-btn" class="btn-action">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>{t.printList}</span>
        </button>

        <button type="button" id="toggle-hide-visited-btn" class="btn-action btn-action-visited" style="display: none;" title={t.hideVisited}>
          <span class="visited-btn-icon" aria-hidden="true">👁️‍🗨️</span>
          <span id="hide-visited-btn-text">{t.hideVisited}</span>
        </button>

        <div class="dropdown-container">
          <button type="button" id="export-csv-btn" class="btn-action btn-action-subtle" title={t.exportCsv}>
            <span>CSV</span>
          </button>
          <button type="button" id="export-json-btn" class="btn-action btn-action-subtle" title={t.exportJson}>
            <span>JSON</span>
          </button>
          <label for="import-json-input" class="btn-action btn-action-subtle" title={t.importJson}>
            <span>Import</span>
            <input type="file" id="import-json-input" accept=".json,application/json" class="sr-only" />
          </label>
        </div>

        <button type="button" id="clear-list-btn" class="btn-action btn-action-danger" title={t.clearList}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span class="sr-only">{t.clearList}</span>
        </button>
      </div>
    </header>

    <!-- Share Feedback Toast -->
    <div id="share-toast" class="toast-message" style="display: none;" role="status">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>{t.shareCopied}</span>
    </div>

    <!-- Shared List Notification Banner (when opened via #list=...) -->
    <aside id="shared-list-banner" class="shared-list-card" style="display: none;" role="status">
      <div class="shared-card-body">
        <div class="shared-card-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
        </div>
        <div class="shared-card-text">
          <h2 class="shared-card-title">{t.sharedListBannerTitle}</h2>
          <p class="shared-card-desc">{t.sharedListBannerText}</p>
        </div>
      </div>
      <div class="shared-card-actions">
        <button type="button" id="save-shared-list-btn" class="btn-pill-primary">
          {t.saveToMyList}
        </button>
        <button type="button" id="dismiss-shared-list-btn" class="btn-pill-secondary">
          {t.dismissSharedBanner}
        </button>
      </div>
    </aside>

    <!-- Empty State View -->
    <div id="empty-list-notice" class="empty-state-box" style="display: none;">
      <div class="empty-icon-wrap" aria-hidden="true">
        <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
      </div>
      <h2 class="empty-title">{lang === 'nl' ? 'Je lijst is nog leeg' : (lang === 'uk' ? 'Ваш список порожній' : 'Your list is empty')}</h2>
      <p class="empty-desc">{t.emptyListNotice}</p>
      <a href={`/${lang}/`} class="btn-pill-primary empty-cta">
        {t.backToFinder} →
      </a>
    </div>

    <!-- Active List Items -->
    <ol id="priority-items-list" class="priority-list" aria-label="Prioriteitenlijst"></ol>

    <!-- Visited Items Hidden Notice Banner -->
    <div id="visited-hidden-banner" class="visited-hidden-banner" style="display: none;" role="status">
      <div class="visited-hidden-info">
        <span class="visited-hidden-icon" aria-hidden="true">👁️‍🗨️</span>
        <span id="visited-hidden-count-text"></span>
      </div>
      <button type="button" id="show-visited-inline-btn" class="btn-link-action">
        {t.showVisited}
      </button>
    </div>
  </div>
</Layout>

<style is:global>
  .list-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .list-page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .header-main {
    flex: 1;
    min-width: 280px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
  }

  .stats-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    max-width: 60ch;
    line-height: 1.5;
  }

  .storage-notice {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.5rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .storage-notice-icon {
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  /* Toolbar */
  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .dropdown-container {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2px 4px;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    line-height: 1;
  }

  .btn-action:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-action-primary {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .btn-action-primary:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: #ffffff;
  }

  .btn-action-subtle {
    border: none;
    background: transparent;
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .btn-action-subtle:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text);
    border-radius: 4px;
  }

  .btn-action-danger {
    color: var(--color-text-muted);
    padding: 0.45rem 0.65rem;
  }

  .btn-action-danger:hover {
    color: var(--color-alert-text);
    background-color: var(--color-alert-bg);
    border-color: var(--color-alert-border);
  }

  /* Toast */
  .toast-message {
    background-color: var(--color-badge-bg);
    border: 1px solid var(--color-badge-border);
    color: var(--color-badge-text);
    padding: 0.65rem 1rem;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  }

  /* Shared card */
  .shared-list-card {
    background-color: var(--color-warn-bg);
    border: 1px solid var(--color-warn-border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .shared-card-body {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    flex: 1;
    min-width: 260px;
  }

  .shared-card-icon {
    color: var(--color-warn-text);
    margin-top: 0.1rem;
  }

  .shared-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-warn-text);
    margin-bottom: 0.2rem;
  }

  .shared-card-desc {
    font-size: 0.9rem;
    color: var(--color-warn-text);
    line-height: 1.4;
  }

  .shared-card-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .btn-pill-primary, .btn-pill-secondary {
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.15s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-pill-primary {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .btn-pill-primary:hover {
    background-color: var(--color-primary-hover);
  }

  .btn-pill-secondary {
    background-color: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-pill-secondary:hover {
    background-color: var(--color-surface-hover);
  }

  /* Empty State */
  .empty-state-box {
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0;
  }

  .empty-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .empty-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .empty-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    max-width: 48ch;
    line-height: 1.6;
  }

  .empty-cta {
    margin-top: 0.5rem;
    padding: 0.65rem 1.4rem;
  }

  /* Priority List Item Cards */
  .priority-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .priority-item-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    position: relative;
  }

  .priority-item-card:hover {
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.06);
    border-color: var(--color-border);
  }

  .priority-item-card.is-dragging {
    opacity: 0.35;
    border-style: dashed;
    border-color: var(--color-accent);
  }

  .priority-item-card.is-drag-over {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .priority-item-card.is-visited {
    background-color: var(--color-surface);
    border-color: var(--color-border-light);
  }

  .priority-item-card.is-visited .item-title a {
    color: var(--color-text-muted);
    text-decoration: line-through;
    text-decoration-color: var(--color-border);
  }

  .card-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-left-col {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    flex: 1;
    min-width: 240px;
  }

  .card-controls-col {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .drag-grip {
    cursor: grab;
    color: var(--color-text-muted);
    padding: 0.35rem 0.2rem;
    display: flex;
    align-items: center;
    opacity: 0.5;
    transition: opacity 0.15s ease;
    user-select: none;
  }

  .drag-grip:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .drag-grip:active {
    cursor: grabbing;
  }

  /* Tactile Circle Check Button for Visited */
  .btn-check-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: transparent;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .btn-check-circle:hover {
    border-color: var(--color-accent);
    transform: scale(1.08);
  }

  .priority-item-card.is-visited .btn-check-circle {
    background-color: var(--color-badge-bg);
    border-color: var(--color-badge-border);
    color: var(--color-badge-text);
  }

  .rank-badge {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    opacity: 0.6;
    min-width: 1.25rem;
    text-align: right;
    flex-shrink: 0;
  }

  /* Small Thumbnail Wrap */
  .card-thumb-wrap {
    width: 64px;
    height: 64px;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .priority-item-card.is-visited .card-thumb-img {
    filter: grayscale(0.85);
    opacity: 0.55;
  }

  .card-thumb-empty {
    font-size: 1.6rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    user-select: none;
  }

  .item-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .item-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .item-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .item-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .item-badges {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 0.825rem;
    color: var(--color-text-muted);
  }

  .city-tag {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .street-tag {
    color: var(--color-text-muted);
  }

  .street-tag::before {
    content: "•";
    margin-right: 0.4rem;
    color: var(--color-border);
  }

  /* Ratings & Categories line */
  .item-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.15rem;
    font-size: 0.8rem;
  }

  .item-rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.12rem 0.45rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-weight: 600;
    color: var(--color-text);
  }

  .rating-count {
    color: var(--color-text-muted);
    font-weight: normal;
    font-size: 0.75rem;
  }

  .item-category-pills {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .item-cat-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.45rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Visited Hidden Banner */
  .visited-hidden-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
  }

  .visited-hidden-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-link-action {
    background: transparent;
    border: none;
    color: var(--color-accent);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
  }

  .btn-action.active {
    background-color: var(--color-primary);
