---
// Redirect root to preferred or browser language (/nl/, /en/, /uk/)
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/nl/" />
    <title>Museumwijzer</title>
    <script is:inline>
      let target = '/nl/';
      try {
        const preferred = localStorage.getItem('preferred_locale');
        if (preferred === 'en' || preferred === 'uk' || preferred === 'nl') {
          target = '/' + preferred + '/';
        } else {
          const navLang = (navigator.language || 'nl').toLowerCase();
          if (navLang.startsWith('en')) {
            target = '/en/';
          } else if (navLang.startsWith('uk')) {
            target = '/uk/';
          } else {
            target = '/nl/';
          }
        }
      } catch (e) {
        // Fallback to /nl/
      }
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Doorsturen naar <a href="/nl/">Nederlands</a>, <a href="/en/">English</a> of <a href="/uk/">Українська</a>...</p>
  </body>
</html>
