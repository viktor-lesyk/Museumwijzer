---
import { languages, type Locale } from '../i18n/languages';
import { useTranslations } from '../i18n/ui';
import metaData from '../../../data/meta.json';
import noticeData from '../../../data/notice.json';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  canonicalPath?: string;
}

const { title, description, locale, canonicalPath = '' } = Astro.props;
const t = useTranslations(locale);
const dir = languages[locale]?.dir || 'ltr';

// Format last updated date from metaData.last_checked
let formattedDate = 'onbekend';
let isStale = false;
if (metaData?.last_checked) {
  try {
    const d = new Date(metaData.last_checked);
    const dateLocales: Record<Locale, string> = {
      nl: 'nl-NL',
      en: 'en-GB',
      uk: 'uk-UA',
    };
    formattedDate = d.toLocaleDateString(dateLocales[locale] || 'nl-NL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
    // Stale check (§8.3): data older than 30 days
    const ageMs = Date.now() - d.getTime();
    if (ageMs > 30 * 24 * 60 * 60 * 1000) {
      isStale = true;
    }
  } catch {
    formattedDate = metaData.last_checked.slice(0, 10);
  }
}

// Compute language alternate paths and canonical URLs
const siteOrigin = Astro.site ? Astro.site.origin : 'https://museumwijzer.nl';
const currentPathWithoutLang = Astro.url.pathname.replace(/^\/(nl|en|uk)/, '');
const nlPath = `/nl${currentPathWithoutLang}`;
const enPath = `/en${currentPathWithoutLang}`;
const ukPath = `/uk${currentPathWithoutLang}`;

const nlUrl = new URL(nlPath, siteOrigin).href;
const enUrl = new URL(enPath, siteOrigin).href;
const ukUrl = new URL(ukPath, siteOrigin).href;
const defaultUrl = new URL('/nl/', siteOrigin).href;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;

// Notice banner configuration
const showNotice = Boolean(noticeData && noticeData.active);
const noticeMessage = showNotice && noticeData.message ? (noticeData.message[locale] || noticeData.message.nl) : '';
const noticeLink = showNotice && noticeData.link ? noticeData.link : null;

// Preview release configuration (controls indexing meta tag)
const isPreview = process.env.PREVIEW !== 'false';
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={isPreview ? "noindex, nofollow" : "index, follow"} />
    <title>{title} — {t.siteTitle}</title>
    <meta name="description" content={description || t.explainer} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-contained CSP -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://*.wikimedia.org https://upload.wikimedia.org; connect-src 'self' https://api.pdok.nl https://*.tile.openstreetmap.org https://tile.openstreetmap.org; frame-src 'self' https://www.openstreetmap.org; frame-ancestors 'none';"
    />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="nl" href={nlUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="uk" href={ukUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <style is:global>
      :root {
        --color-bg: #f8fafc;
        --color-surface: #ffffff;
        --color-surface-hover: #f1f5f9;
        --color-text: #0f172a;
        --color-text-muted: #475569;
        --color-border: #cbd5e1;
        --color-border-light: #e2e8f0;
        --color-primary: #1e3a5f;
        --color-primary-hover: #0f233d;
        --color-accent: #2563eb;
        --color-badge-bg: #f0fdf4;
        --color-badge-text: #166534;
        --color-badge-border: #bbf7d0;
        --color-warn-bg: #fffbeb;
        --color-warn-border: #fde68a;
        --color-warn-text: #92400e;
        --color-alert-bg: #fef2f2;
        --color-alert-border: #fecaca;
        --color-alert-text: #991b1b;
        --max-width: 1100px;
        --radius: 8px;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-bg: #0f172a;
          --color-surface: #1e293b;
          --color-surface-hover: #334155;
          --color-text: #f8fafc;
          --color-text-muted: #94a3b8;
          --color-border: #334155;
          --color-border-light: #1e293b;
          --color-primary: #3b82f6;
          --color-primary-hover: #60a5fa;
          --color-accent: #60a5fa;
          --color-badge-bg: #14532d;
          --color-badge-text: #dcfce7;
          --color-badge-border: #166534;
          --color-warn-bg: #78350f;
          --color-warn-border: #b45309;
          --color-warn-text: #fef3c7;
          --color-alert-bg: #7f1d1d;
          --color-alert-border: #991b1b;
          --color-alert-text: #fee2e2;
        }
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      a:hover {
        color: var(--color-primary-hover);
      }

      a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
        outline: 3px solid var(--color-accent);
        outline-offset: 2px;
      }

      .container {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      /* Site Notice Banner */
      .site-notice-banner {
        padding: 0.85rem 1.25rem;
        font-size: 0.95rem;
        line-height: 1.4;
        text-align: center;
        border-bottom: 1px solid transparent;
      }

      .site-notice-banner.notice-info {
        background-color: var(--color-surface);
        border-color: var(--color-border);
        color: var(--color-text);
      }

      .site-notice-banner.notice-warning {
        background-color: var(--color-warn-bg);
        border-color: var(--color-warn-border);
        color: var(--color-warn-text);
      }

      .site-notice-banner.notice-alert {
        background-color: var(--color-alert-bg);
        border-color: var(--color-alert-border);
        color: var(--color-alert-text);
      }


      .site-notice-content {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .site-notice-content a {
        font-weight: 600;
        color: inherit;
      }

      .site-header {
        background-color: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        padding: 1rem 0;
      }

      .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--color-text);
      }

      .brand-logo {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        flex-shrink: 0;
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--color-primary);
      }

      .brand-tagline {
        font-size: 0.78rem;
        color: var(--color-text-muted);
        line-height: 1.25;
      }

      .btn-nav-tickets {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.85rem;
        border-radius: 9999px;
        background-color: var(--color-primary);
        color: #ffffff !important;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none !important;
        box-shadow: 0 1px 3px rgba(30, 58, 95, 0.2);
        transition: background-color 0.15s ease, transform 0.15s ease;
      }

      .btn-nav-tickets:hover {
        background-color: var(--color-primary-hover);
        transform: translateY(-1px);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        list-style: none;
      }

      .nav-links a {
        text-decoration: none;
        font-weight: 500;
        color: var(--color-text);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }

      .nav-links a:hover {
        color: var(--color-primary);
        background-color: var(--color-surface-hover);
      }

      .nav-badge-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-accent);
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 700;
        min-width: 1.25rem;
        height: 1.25rem;
        padding: 0 0.3rem;
        border-radius: 999px;
      }

      .lang-switcher {
        display: flex;
        gap: 0.25rem;
        background-color: var(--color-bg);
        padding: 0.25rem;
        border-radius: var(--radius);
        border: 1px solid var(--color-border);
      }

      .lang-switcher a {
        padding: 0.2rem 0.6rem;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 4px;
        color: var(--color-text-muted);
      }

      .lang-switcher a.active {
        background-color: var(--color-surface);
        color: var(--color-text);
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      }

      main {
        flex: 1;
        padding: 2rem 0 4rem;
      }

      .site-footer {
        background-color: var(--color-surface);
        border-top: 1px solid var(--color-border);
        padding: 2.5rem 0;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .footer-disclaimer {
        padding: 1rem;
        background-color: var(--color-bg);
        border-radius: var(--radius);
        border-inline-start: 4px solid var(--color-accent);
      }

      .footer-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        font-size: 0.8rem;
        border-top: 1px solid var(--color-border-light);
        padding-top: 1rem;
      }

      @media print {
        .site-header, .site-footer, .site-notice-banner, .btn-primary, .btn-secondary, .btn-outline {
          display: none !important;
        }
        body {
          background-color: #ffffff !important;
          color: #000000 !important;
        }
        main {
          padding: 0 !important;
        }
      }
    </style>

    <script is:inline define:vars={{ currentLocale: locale }}>
      // Remember preferred locale in localStorage
      try {
        localStorage.setItem('preferred_locale', currentLocale);
      } catch (e) {
        // Storage not available
      }

      // Update nav list counter if items exist in localStorage
      document.addEventListener('DOMContentLoaded', () => {
        try {
          const raw = localStorage.getItem('museumwijzer_priority_list');
          if (raw) {
            const list = JSON.parse(raw);
            if (Array.isArray(list) && list.length > 0) {
              const badge = document.getElementById('nav-list-count');
              if (badge) {
                badge.textContent = String(list.length);
                badge.style.display = 'inline-flex';
              }
            }
          }
        } catch (e) {}
      });
    </script>
  </head>
  <body>

    <!-- Site-wide Notice Banner (controlled by data/notice.json or stale data) -->
    {showNotice && (
      <aside class={`site-notice-banner notice-${noticeData.level || 'info'}`} role="status">
        <div class="site-notice-content">
          <span>{noticeMessage}</span>
          {noticeLink && (
            <a href={noticeLink.url} target="_blank" rel="noopener noreferrer">
              {noticeLink.text?.[locale] || noticeLink.text?.nl || 'Lees meer'} ↗
            </a>
          )}
        </div>
      </aside>
    )}

    {!showNotice && isStale && (
      <aside class="site-notice-banner notice-warning" role="alert">
        <div class="site-notice-content">
          <span>{t.staleDataWarning}</span>
          <a href={t.officialListUrl} target="_blank" rel="noopener noreferrer">
            {t.checkOfficialList} ↗
          </a>
        </div>
      </aside>
    )}

    <header class="site-header">
      <div class="container header-content">
        <a href={`/${locale}/`} class="brand">
          <img src="/favicon.svg" alt="" width="36" height="36" class="brand-logo" aria-hidden="true" />
          <div class="brand-text">
            <span class="brand-name">{t.siteTitle}</span>
            <span class="brand-tagline">{t.siteTagline}</span>
          </div>
        </a>

        <nav aria-label="Main Navigation">
          <ul class="nav-links">
            <li><a href={`/${locale}/`}>{t.navFinder}</a></li>
            <li><a href={`/${locale}/#map`}>{t.mapView}</a></li>
            <li>
              <a href={`/${locale}/list/`}>
                <span>{t.navMyList}</span>
                <span id="nav-list-count" class="nav-badge-count" style="display: none;" aria-label="Aantal musea in lijst">0</span>
              </a>
            </li>
            <li><a href={`/${locale}/about/`}>{t.navAbout}</a></li>
            <li>
              <a href={t.requestTicketsUrl} class="btn-nav-tickets" target="_blank" rel="noopener noreferrer">
                <span class="ticket-icon" aria-hidden="true">🎟️</span>
                <span>{t.requestTicketsNav}</span>
                <span class="arrow-icon" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <div class="lang-switcher" aria-label="Language selector">
                <a href={nlPath} class={locale === 'nl' ? 'active' : ''} aria-current={locale === 'nl' ? 'true' : undefined}>NL</a>
                <a href={enPath} class={locale === 'en' ? 'active' : ''} aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
                <a href={ukPath} class={locale === 'uk' ? 'active' : ''} aria-current={locale === 'uk' ? 'true' : undefined}>UK</a>
              </div>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-disclaimer">
          <p><strong>{t.footerDisclaimer}</strong></p>
        </div>
        <div class="footer-meta">
          <span><a href={t.officialListUrl} target="_blank" rel="noopener noreferrer">{t.footerDataSource}</a></span>
          <span>{t.footerLastUpdated.replace('{date}', formattedDate)}</span>
          <span>{t.footerGeodata}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
